            <!-- ============================================================= -->
            <!-- หน้า 2: การล้างข้อมูล & DSP                                   -->
            <!-- ============================================================= -->
            <section id="page-step-2" class="step-page">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <span class="badge-neon-teal mb-1">ระยะที่ 2 (Phase 2)</span>
                        <h2 class="fw-bold mb-0 text-dark">🌊 การทำความสะอาดข้อมูล & การตรวจสอบสัญญาณดิจิทัล DSP</h2>
                    </div>
                    <div>
                        <span class="badge-neon-green">
                            <i class="fas fa-microchip me-1"></i> Butterworth 0.5–45Hz + 50Hz Notch Filter
                        </span>
                    </div>
                </div>

                <div class="callout-box" id="sec-dsp-pipeline">
                    <strong><i class="fas fa-filter me-1"></i> ระเบียบวิธีประมวลผลสัญญาณชีวการแพทย์ (Biomedical DSP Methodology):</strong><br>
                    สัญญาณคลื่นไฟฟ้าหัวใจดิบจากร่างกายมนุษย์มักปนเปื้อนสัญญาณรบกวน 3 ชนิดหลัก: การเคลื่อนไหวของกระบังลมขณะหายใจ (Baseline Wander &lt;0.5 Hz), สัญญาณรบกวนจากกระแสไฟฟ้าอาคาร (Powerline Noise 50 Hz), และสัญญาณไฟฟ้ากล้ามเนื้อ (EMG Noise &gt;45 Hz)
                    ระบบจึงใช้ลำดับตัวกรองแบบ Zero-Phase Digital Filtering:
                    <div class="row mt-2 g-2 small">
                        <div class="col-md-4">
                            <strong>1. กำจัดการแกว่งเส้นฐาน:</strong> Linear Detrending ดึงระดับสัญญาณให้อยู่บนแกน 0.0 mV อย่างสม่ำเสมอ
                        </div>
                        <div class="col-md-4">
                            <strong>2. ตัวกรองแถบความถี่ Butterworth:</strong> แถบความถี่ 0.5–45.0 Hz (อันดับที่ 3) ผ่านฟังก์ชัน <code>filtfilt</code>
                        </div>
                        <div class="col-md-4">
                            <strong>3. ตัวกรองความถี่เฉพาะ IIR Notch:</strong> ตัดความถี่ไฟฟ้า 50.0 Hz โดยตรง (Q=30.0) กำจัดเสียงฮัมหมดจด
                        </div>
                    </div>
                </div>

                <!-- Heavy Cleaning Audit Logs -->
                <div class="card card-custom mb-4">
                    <div class="card-header-custom">
                        <span><i class="fas fa-list-check me-2 text-primary"></i> บันทึกการตรวจสอบการล้างข้อมูลอย่างละเอียด (Heavy Cleaning Audit Rules Log)</span>
                        <span class="badge-neon-green">ผ่านการตรวจสอบ 6 กฎหลัก</span>
                    </div>
                    <div class="card-body-custom p-0">
                        <table class="table table-custom">
                            <thead>
                                <tr>
                                    <th>รหัสกฎ (Rule ID)</th>
                                    <th>ชื่อกฎและการทำงาน (Rule Name & Action)</th>
                                    <th>จำนวนรายการที่ได้รับผลกระทบ</th>
                                    <th>การจัดการ (Action)</th>
                                    <th>สถานะการตรวจสอบ (Status)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><code>R01_TARGET_ISOLATION</code></td>
                                    <td>ตัดรายการที่ไม่มีรหัสการวินิจฉัยโรคหัวใจยืนยันโดยแพทย์ (Unlabelled Target)</td>
                                    <td>411 รายการ</td>
                                    <td><span class="badge-neon-coral">ตัดทิ้ง (Drop Rows)</span></td>
                                    <td><span class="badge-neon-green">ผ่าน 100%</span></td>
                                </tr>
                                <tr>
                                    <td><code>R02_DEDUPLICATION</code></td>
                                    <td>ตรวจสอบความซ้ำซ้อนของรหัสบันทึกปฐมภูมิ (Primary Key ecg_id)</td>
                                    <td>0 รายการ</td>
                                    <td><span class="badge-neon-teal">ไม่มีค่าซ้ำ</span></td>
                                    <td><span class="badge-neon-green">ผ่าน 100%</span></td>
                                </tr>
                                <tr>
                                    <td><code>R03_BASELINE_WANDER</code></td>
                                    <td>กำจัดการแกว่งของเส้นฐานจากการหายใจด้วย Linear Detrending &amp; Highpass &gt;0.5 Hz</td>
                                    <td>21,388 รายการ</td>
                                    <td><span class="badge-neon-blue">ปรับแก้สัญญาณ DSP</span></td>
                                    <td><span class="badge-neon-green">ผ่าน 100%</span></td>
                                </tr>
                                <tr>
                                    <td><code>R04_BANDPASS_FILTER</code></td>
                                    <td>กรองแถบความถี่ Butterworth Bandpass 0.5–45.0 Hz แบบ Zero-Phase (Order 3)</td>
                                    <td>21,246 รายการ</td>
                                    <td><span class="badge-neon-blue">กรองสัญญาณดิจิทัล</span></td>
                                    <td><span class="badge-neon-green">ผ่าน 100%</span></td>
                                </tr>
                                <tr>
                                    <td><code>R05_POWERLINE_NOTCH</code></td>
                                    <td>กำจัดสัญญาณรบกวนสายส่งไฟฟ้ากระแสสลับ Notch Filter 50.0 Hz (Q=30.0)</td>
                                    <td>21,246 รายการ</td>
                                    <td><span class="badge-neon-blue">กรองคลื่น 50Hz</span></td>
                                    <td><span class="badge-neon-green">ผ่าน 100%</span></td>
                                </tr>
                                <tr>
                                    <td><code>R06_SQI_QUARANTINE</code></td>
                                    <td>คัดกรองดัชนีคุณภาพสัญญาณ ตรวจจับสัญญาณอิ่มตัว ขาดหาย หรือ SNR ต่ำวิกฤต</td>
                                    <td>142 รายการ</td>
                                    <td><span class="badge-neon-purple">แยกกักกัน (Quarantined)</span></td>
                                    <td><span class="badge-neon-green">ผ่าน 100%</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Dual Waveform Viewer: Raw vs Denoised (100% FULL WIDTH col-12) -->
                <div class="card card-custom mb-4" id="sec-dual-waveform">
                    <div class="card-header-custom">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-eye me-2 text-danger"></i>
                            <span>หน้าต่างเปรียบเทียบคลื่นไฟฟ้าหัวใจคู่ขนาน (Dual Waveform Viewer: Raw vs. Denoised EKG — 100% Full-Width)</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <label class="small text-muted mb-0 font-code">เลือกเคส:</label>
                            <select class="form-select form-select-sm" id="select-dual-sample" style="width: 220px;" onchange="updateDualWaveformPlot()">
                                <option value="1">ECG #1 (ปกติ NORM)</option>
                                <option value="2">ECG #2 (ปกติ NORM)</option>
                                <option value="3">ECG #3 (กล้ามเนื้อหัวใจขาดเลือด MI)</option>
                                <option value="4">ECG #4 (นำไฟฟ้าขัดข้อง CD)</option>
                                <option value="5">ECG #5 (หัวใจโต HYP)</option>
