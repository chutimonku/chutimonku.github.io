25\u0e49\u0e32\u0e21\u0e40\u0e19\u0e37\u0e49\u0e2d\u0e2b\u0e31\u0e27\u0e43\u0e08\u0e02\u0e32\u0e14\u0e40\u0e25\u0e37\u0e2d\u0e14\u0e40\u0e09\u0e35\u0e22\u0e1a\u0e1e\u0e25\u0e31\u0e19/\u0e41\u0e1c\u0e25\u0e40\u0e1b\u0e47\u0e19\u0e17\u0e35\u0e48\u0e01\u0e25\u0e49\u0e32\u0e21\u0e40\u0e19\u0e37\u0e49\u0e2d\u0e2b\u0e31\u0e27\u0e43\u0e08 (Myocardial Infarction / STEMI Risk) \u0e14\u0e49\u0e27\u0e22\u0e04\u0e27\u0e32\u0e21\u0e40\u0e0a\u0e37\u0e48\u0e2d\u0e21\u0e31\u0e48\u0e19\u0e02\u0e2d\u0e07 AI \u0e2a\u0e39\u0e07\u0e16\u0e36\u0e07 76.5% \u0e42\u0e14\u0e22\u0e21\u0e35\u0e01\u0e32\u0e23\u0e22\u0e01\u0e15\u0e31\u0e27\u0e02\u0e2d\u0e07\u0e0a\u0e48\u0e27\u0e07 ST \u0e2a\u0e39\u0e07\u0e16\u0e36\u0e07 +0.03 mV", "morphology_evaluation": "\u0e01\u0e32\u0e23\u0e40\u0e1b\u0e25\u0e35\u0e48\u0e22\u0e19\u0e41\u0e1b\u0e25\u0e07\u0e02\u0e2d\u0e07\u0e0a\u0e48\u0e27\u0e07 ST-Segment Elevation (+0.03 mV \u0e17\u0e35\u0e48\u0e08\u0e38\u0e14 J+60ms) \u0e1a\u0e48\u0e07\u0e0a\u0e35\u0e49\u0e01\u0e32\u0e23\u0e02\u0e32\u0e14\u0e40\u0e25\u0e37\u0e2d\u0e14\u0e02\u0e2d\u0e07\u0e01\u0e25\u0e49\u0e32\u0e21\u0e40\u0e19\u0e37\u0e49\u0e2d\u0e2b\u0e31\u0e27\u0e43\u0e08\u0e41\u0e1a\u0e1a Transmural Ischemia \u0e2a\u0e31\u0e21\u0e1e\u0e31\u0e19\u0e18\u0e4c\u0e01\u0e31\u0e1a\u0e20\u0e32\u0e27\u0e30\u0e2b\u0e25\u0e2d\u0e14\u0e40\u0e25\u0e37\u0e2d\u0e14\u0e2b\u0e31\u0e27\u0e43\u0e08\u0e42\u0e04\u0e42\u0e23\u0e19\u0e32\u0e23\u0e35\u0e2d\u0e38\u0e14\u0e15\u0e31\u0e19\u0e40\u0e09\u0e35\u0e22\u0e1a\u0e1e\u0e25\u0e31\u0e19 \u0e04\u0e25\u0e37\u0e48\u0e19 QRS \u0e01\u0e27\u0e49\u0e32\u0e07 20 ms", "autonomic_evaluation": "\u0e04\u0e27\u0e32\u0e21\u0e41\u0e1b\u0e23\u0e1b\u0e23\u0e27\u0e19\u0e02\u0e2d\u0e07\u0e2b\u0e31\u0e27\u0e43\u0e08\u0e25\u0e14\u0e15\u0e48\u0e33\u0e25\u0e07\u0e1c\u0e34\u0e14\u0e1b\u0e01\u0e15\u0e34 (SDNN = 55.2 ms, RMSSD = 50.9 ms) \u0e2a\u0e2d\u0e14\u0e04\u0e25\u0e49\u0e2d\u0e07\u0e01\u0e31\u0e1a\u0e20\u0e32\u0e27\u0e30\u0e01\u0e23\u0e30\u0e15\u0e38\u0e49\u0e19\u0e02\u0e2d\u0e07\u0e23\u0e30\u0e1