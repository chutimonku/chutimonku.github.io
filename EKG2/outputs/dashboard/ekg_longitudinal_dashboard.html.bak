        let activeStep = 'step-1';
        let currentPatientId = '21602';
        let currentEncounterId = null;

        // Auto render math formulas
        document.addEventListener("DOMContentLoaded", function() {
            if (typeof renderMathInElement !== 'undefined') {
                renderMathInElement(document.body, {
                    delimiters: [
                        {left: "$$", right: "$$", display: true},
                        {left: "$", right: "$", display: false}
                    ]
                });
            }

            initStep1();
            initStep2();
            initStep3();
            initStep4();
            initStep5();
        });

        // ---------------------------------------------------------------------
        // Navigation & Page Isolation Logic (showPage & switchStep interchangeable)
        // ---------------------------------------------------------------------
        function showPage(pageId) {
            if (!pageId) return;
            let stepId = pageId;
            if (!stepId.startsWith('step-')) {
                stepId = 'step-' + stepId.replace('page-', '');
            }

            activeStep = stepId;

            // Hide all pages
            document.querySelectorAll('.step-page').forEach(page => {
                page.classList.remove('active-page');
            });

            // Show selected page
            const targetPage = document.getElementById('page-' + stepId);
            if (targetPage) {
                targetPage.classList.add('active-page');
            }

            // Update sidebar buttons
            document.querySelectorAll('.nav-step-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            const activeBtn = document.getElementById('btn-' + stepId);
            if (activeBtn) {
                activeBtn.classList.add('active');
            }

            // Accordion submenu toggle
            document.querySelectorAll('.submenu-list').forEach(sub => sub.classList.remove('show'));
            document.querySelectorAll('.chevron-icon').forEach(icon => {
                icon.classList.remove('fa-chevron-down');
                icon.classList.add('fa-chevron-right');
            });

            const activeSubmenu = document.getElementById('submenu-' + stepId);
            if (activeSubmenu) {
                activeSubmenu.classList.add('show');
            }
            const activeChevron = document.getElementById('chevron-' + stepId);
            if (activeChevron) {
                activeChevron.classList.remove('fa-chevron-right');
                activeChevron.classList.add('fa-chevron-down');
            }

            // Scroll to top
            window.scrollTo({top: 0, behavior: 'smooth'});

            // Trigger Plotly relayout to resize cleanly
            setTimeout(() => {
                window.dispatchEvent(new Event('resize'));
            }, 100);
        }
        window.showPage = showPage;

        function jumpSection(stepId, sectionId, e) {
            if (e) e.preventDefault();
            showPage(stepId);
            setTimeout(() => {
                const target = document.getElementById(sectionId);
                if (target) {
                    const topOffset = 80;
                    const elementPosition = target.getBoundingClientRect().top;
                    const offsetPosition = elementPosition + window.pageYOffset - topOffset;
                    window.scrollTo({
                        top: offsetPosition,
                        behavior: 'smooth'
                    });
                }
            }, 150);
        }
        window.jumpSection = jumpSection;

        function toggleSidebar() {
            const sidebar = document.querySelector('.sidebar');
            const mainCanvas = document.querySelector('.main-canvas');
            if (sidebar && mainCanvas) {
                sidebar.classList.toggle('collapsed');
                mainCanvas.classList.toggle('sidebar-collapsed');
                setTimeout(() => {
                    window.dispatchEvent(new Event('resize'));
                }, 320);
            }
        }
        window.toggleSidebar = toggleSidebar;

        // ---------------------------------------------------------------------
        // STEP 1: GOVERNANCE & DATA FOUNDATION
        // ---------------------------------------------------------------------
        function initStep1() {
            // Multi-Visit Distribution Plot
            const visitData = DASHBOARD_DATA.summary.visit_distribution;
            const visitX = Object.keys(visitData).map(k => k + ' ครั้ง');
            const visitY = Object.values(visitData);

            Plotly.newPlot('chart-visit-dist', [{
                x: visitX,
                y: visitY,
                type: 'bar',
                marker: {
                    color: '#0284c7',
                    line: {color: '#cbd5e1', width: 1}
                },
                text: visitY.map(v => v.toLocaleString() + ' คน'),
                textposition: 'outside'
            }], {
                margin: {t: 20, b: 40, l: 60, r: 20},
                paper_bgcolor: '#ffffff',
                plot_bgcolor: '#f8fafc',
                font: {family: "'JetBrains Mono', 'Outfit', sans-serif", color: '#0f172a', size: 11},
                xaxis: {title: 'จำนวนครั้งที่ตรวจ EKG ต่อผู้ป่วย 1 คน (Visit Frequency)', gridcolor: '#f1f5f9'},
                yaxis: {title: 'จำนวนผู้ป่วย (คน)', gridcolor: '#f1f5f9'}
            }, {responsive: true});

            // Data Attrition Funnel Plot
            Plotly.newPlot('chart-funnel', [{
                type: 'funnel',
                y: ['1. ข้อมูลดิบทั้งหมด (Raw)', '2. มีฉลากวินิจฉัย (Target)', '3. ผ่านตัวกรอง DSP (Filtered)', '4. ผ่านเกณฑ์คุณภาพ (Clean Parquet)'],
                x: [21799, 21388, 21388, 21246],
                textinfo: 'value+percent initial',
                marker: {
                    color: ['#0284c7', '#0ea5e9', '#14b8a6', '#10b981']
                }
            }], {
                margin: {t: 20, b: 30, l: 230, r: 40},
                paper_bgcolor: '#ffffff',
                font: {family: "'JetBrains Mono', 'Outfit', sans-serif", color: '#0f172a', size: 11}
            }, {responsive: true});

            // Data Dictionary Table
            const tbodyDict = document.getElementById('tbody-data-dict');
            if (tbodyDict) {
                let html = '';
                DASHBOARD_DATA.data_dictionary.forEach(row => {
                    html += `<tr>
                        <td><code>${row.column}</code></td>
                        <td><span class="code-chip">${row.type}</span></td>
                        <td>${row.unit}</td>
                        <td><span class="badge-neon-blue">${row.category}</span></td>
                        <td>${row.role}</td>
                        <td>${row.description}</td>
                    </tr>`;
                });
                tbodyDict.innerHTML = html;
            }

            // Missing Data Table
            const tbodyMissing = document.getElementById('tbody-missing-inv');
            if (tbodyMissing) {
                let html = '';
                DASHBOARD_DATA.missing_data_inventory.forEach(m => {
                    const badgeClass = m.missing_pct > 50 ? 'badge-neon-coral' : (m.missing_pct > 0 ? 'badge-neon-teal' : 'badge-neon-green');
                    html += `<tr>
                        <td><code>${m.variable}</code></td>
                        <td><strong>${m.missing_count.toLocaleString()}</strong></td>
                        <td><span class="${badgeClass}">${m.missing_pct.toFixed(2)}%</span></td>
                        <td><strong>${m.mechanism_thai}</strong></td>
                        <td class="small text-muted">${m.clinical_reason}</td>
                        <td class="small"><code>${m.imputation_method}</code></td>
                    </tr>`;
                });
                tbodyMissing.innerHTML = html;
            }

            // Provenance Table
            const tbodyProv = document.getElementById('tbody-provenance');
            if (tbodyProv) {
                let html = '';
                for (const [key, p] of Object.entries(DASHBOARD_DATA.provenance)) {
                    html += `<tr>
                        <td>
                            <strong>${p.name}</strong>
                            <div class="small text-muted font-code">${p.path}</div>
                        </td>
                        <td>${p.modality}</td>
                        <td><strong>${p.records.toLocaleString()}</strong></td>
                        <td><code>${p.size}</code></td>
                        <td><span class="code-chip text-primary">${p.sha256}</span></td>
                        <td><span class="badge-neon-green">${p.status}</span></td>
                    </tr>`;
                }
                tbodyProv.innerHTML = html;
            }
        }

        // ---------------------------------------------------------------------
        // STEP 2: CLEANING & SIGNAL PROCESSING (DSP)
        // ---------------------------------------------------------------------
        function initStep2() {
            // SQI Heatmap
            const sqi = DASHBOARD_DATA.sqi_heatmap;
            Plotly.newPlot('chart-sqi-heatmap', [{
                z: sqi.z,
                x: sqi.leads,
                y: sqi.metrics,
                type: 'heatmap',
                colorscale: [
                    [0, '#f0f9ff'],
                    [0.5, '#38bdf8'],
                    [1, '#0284c7']
                ],
                colorbar: {thickness: 12, title: 'ดัชนี SQI', tickfont: {family: 'JetBrains Mono', color: '#0f172a'}}
            }], {
                margin: {t: 20, b: 40, l: 230, r: 20},
                paper_bgcolor: '#ffffff',
                plot_bgcolor: '#f8fafc',
                font: {family: "'JetBrains Mono', 'Outfit', sans-serif", color: '#0f172a', size: 11},
                xaxis: {title: 'ลีดคลื่นไฟฟ้าหัวใจ (12 Leads)', tickfont: {family: 'JetBrains Mono', weight: 'bold'}}
            }, {responsive: true});

            // Quarantine Registry Table
            const tbodyQuar = document.getElementById('tbody-quarantine');
            if (tbodyQuar) {
                let html = '';
                DASHBOARD_DATA.quarantine_list.forEach(q => {
                    html += `<tr>
                        <td><code>#${q.ecg_id}</code></td>
                        <td>#${q.patient_id}</td>
                        <td>${q.age} ปี / ${q.sex}</td>
                        <td><span class="badge-neon-coral font-code">${q.reason}</span></td>
                        <td class="small text-muted">${q.action}</td>
                    </tr>`;
                });
                tbodyQuar.innerHTML = html;
            }

            updateDualWaveformPlot();
        }

        function updateDualWaveformPlot() {
            const sampleId = document.getElementById('select-dual-sample').value;
            const lead = document.getElementById('select-dual-lead').value;
            const sample = DASHBOARD_DATA.dual_waveforms[sampleId];
            if (!sample) return;

            const rawSig = sample.raw[lead] || [];
            const cleanSig = sample.clean[lead] || [];
            const timeAxis = Array.from({length: rawSig.length}, (_, i) => (i * 0.02).toFixed(2));

            Plotly.newPlot('chart-dual-waveform', [
                {
                    x: timeAxis,
                    y: rawSig,
                    type: 'scatter',
                    mode: 'lines',
                    name: 'สัญญาณดิบ (Raw: Baseline Drift + 50Hz Noise)',
                    line: {color: '#f43f5e', width: 1.4}
                },
                {
                    x: timeAxis,
                    y: cleanSig,
                    type: 'scatter',
                    mode: 'lines',
                    name: 'สัญญาณผ่านการกรอง (Clean: 0.5–45Hz Bandpass + 50Hz Notch)',
                    line: {color: '#0284c7', width: 2.2}
                }
            ], {
                margin: {t: 20, b: 35, l: 50, r: 20},
                paper_bgcolor: '#ffffff',
                plot_bgcolor: '#f8fafc',
                font: {family: "'JetBrains Mono', 'Outfit', sans-serif", color: '#0f172a', size: 11},
                xaxis: {title: 'เวลา (วินาที - Seconds)', gridcolor: '#f1f5f9'},
                yaxis: {title: 'แรงดันไฟฟ้า (มิลลิโวลต์ - mV)', gridcolor: '#f1f5f9'},
                legend: {x: 0.01, y: 0.99, bgcolor: 'rgba(255,255,255,0.92)'}
            }, {responsive: true});

            const metricsBox = document.getElementById('box-dual-metrics');
            if (metricsBox) {
                metricsBox.innerHTML = `
                    <div class="col-md-3">
                        <div class="p-2 rounded-3 bg-light border">
                            <span class="small text-muted font-code">ผลการวินิจฉัย:</span>
                            <div class="fw-bold text-dark">${sample.diagnosis}</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-2 rounded-3 bg-light border">
                            <span class="small text-muted font-code">อัตราส่วน SNR:</span>
                            <div class="fw-bold text-primary">${sample.snr_db} dB</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-2 rounded-3 bg-light border">
                            <span class="small text-muted font-code">ความโด่ง Kurtosis:</span>
                            <div class="fw-bold text-info">${sample.kurtosis}</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-2 rounded-3 bg-light border">
                            <span class="small text-muted font-code">สถานะทางคลินิก:</span>
                            <div class="fw-bold text-success">${sample.status}</div>
                        </div>
                    </div>
                `;
            }
        }

        // ---------------------------------------------------------------------
        // STEP 3: EXPLORATORY DATA ANALYSIS (EDA) & FEATURE FUSION
        // ---------------------------------------------------------------------
        function initStep3() {
            const rec1 = DASHBOARD_DATA.rec1_overlay;
            const timeAxis = rec1.time;
            const lead2 = rec1.lead2;

            const traces = [{
                x: timeAxis,
                y: lead2,
                type: 'scatter',
                mode: 'lines',
                name: 'คลื่นไฟฟ้าลีด II กรองแล้ว (Filtered Lead II)',
                line: {color: '#0284c7', width: 2.2}
            }];

            const rX = rec1.r_peaks.map(idx => timeAxis[idx]);
            const rY = rec1.r_peaks.map(idx => lead2[idx]);
            traces.push({
                x: rX,
                y: rY,
                type: 'scatter',
                mode: 'markers',
                name: 'ยอด R-Peaks (Pan-Tompkins Detection)',
                marker: {color: '#f43f5e', size: 9, symbol: 'circle'}
            });

            const shapes = [];
            rec1.qrs_markers.slice(0, 4).forEach((m, i) => {
                shapes.push({
                    type: 'rect',
                    x0: timeAxis[m.q_start],
                    x1: timeAxis[m.s_end],
                    y0: Math.min(...lead2.slice(m.q_start, m.s_end + 1)) - 0.05,
                    y1: Math.max(...lead2.slice(m.q_start, m.s_end + 1)) + 0.05,
                    fillcolor: 'rgba(14, 165, 233, 0.15)',
                    line: {color: 'rgba(14, 165, 233, 0.6)', width: 1}
                });
            });

            Plotly.newPlot('chart-biomedical-overlay', traces, {
                shapes: shapes,
                margin: {t: 20, b: 35, l: 50, r: 20},
                paper_bgcolor: '#ffffff',
                plot_bgcolor: '#f8fafc',
                font: {family: "'JetBrains Mono', 'Outfit', sans-serif", color: '#0f172a', size: 11},
                xaxis: {title: 'เวลา (วินาที - Seconds)', gridcolor: '#f1f5f9'},
                yaxis: {title: 'แรงดันไฟฟ้า (มิลลิโวลต์ - mV)', gridcolor: '#f1f5f9'},
                legend: {x: 0.01, y: 0.99, bgcolor: 'rgba(255,255,255,0.92)'}
            }, {responsive: true});

            // Welch PSD Spectrum
            const psd = DASHBOARD_DATA.welch_psd;
            Plotly.newPlot('chart-welch-psd', [{
                x: psd.freqs,
                y: psd.psd,
                type: 'scatter',
                mode: 'lines',
                fill: 'tozeroy',
                fillcolor: 'rgba(2, 132, 199, 0.12)',
                line: {color: '#0284c7', width: 2.2},
                name: 'กำลังความหนาแน่นสเปกตรัม PSD'
            }], {
                shapes: [
                    {type: 'rect', x0: 0.04, x1: 0.15, y0: 0, y1: Math.max(...psd.psd)*1.1, fillcolor: 'rgba(14, 165, 233, 0.15)', line: {width: 0}},
                    {type: 'rect', x0: 0.15, x1: 0.40, y0: 0, y1: Math.max(...psd.psd)*1.1, fillcolor: 'rgba(16, 185, 129, 0.15)', line: {width: 0}}
                ],
                annotations: [
                    {x: 0.095, y: Math.max(...psd.psd)*0.85, text: 'LF Band (0.04-0.15Hz)', showarrow: false, font: {family: 'JetBrains Mono', size: 10, color: '#0369a1'}},
                    {x: 0.275, y: Math.max(...psd.psd)*0.85, text: 'HF Band (0.15-0.40Hz)', showarrow: false, font: {family: 'JetBrains Mono', size: 10, color: '#065f46'}}
                ],
                margin: {t: 20, b: 35, l: 50, r: 20},
                paper_bgcolor: '#ffffff',
                plot_bgcolor: '#f8fafc',
                font: {family: "'JetBrains Mono', 'Outfit', sans-serif", color: '#0f172a', size: 11},
                xaxis: {title: 'ความถี่ (เฮิรตซ์ - Hz)', gridcolor: '#f1f5f9'},
                yaxis: {title: 'กำลังสเปกตรัม (ms²/Hz)', gridcolor: '#f1f5f9'}
            }, {responsive: true});

            // Morphology Boxplot
            const morph = DASHBOARD_DATA.morph_by_class;
            const boxTraces = [];
            const colors = {'NORM': '#10b981', 'MI': '#f43f5e', 'STTC': '#f59e0b', 'CD': '#8b5cf6', 'HYP': '#14b8a6'};

            for (const [cls, vals] of Object.entries(morph)) {
                boxTraces.push({
                    y: vals.qrs_duration,
                    name: cls,
                    type: 'box',
                    marker: {color: colors[cls] || '#0284c7'}
                });
            }

            Plotly.newPlot('chart-morphology-box', boxTraces, {
                margin: {t: 20, b: 35, l: 50, r: 20},
                paper_bgcolor: '#ffffff',
                plot_bgcolor: '#f8fafc',
                font: {family: "'JetBrains Mono', 'Outfit', sans-serif", color: '#0f172a', size: 11},
                yaxis: {title: 'ความกว้างคลื่น QRS (มิลลิวินาที - ms)', gridcolor: '#f1f5f9'}
            }, {responsive: true});

            // Pearson Correlation Heatmap
            const corr = DASHBOARD_DATA.eda_correlation;
            Plotly.newPlot('chart-corr-heatmap', [{
                z: corr.z,
                x: corr.features,
                y: corr.features,
                type: 'heatmap',
                colorscale: [
                    [0, '#f43f5e'],
                    [0.5, '#ffffff'],
                    [1, '#0284c7']
                ],
                zmin: -1,
                zmax: 1,
                colorbar: {thickness: 12, title: 'r'}
            }], {
                margin: {t: 20, b: 110, l: 150, r: 20},
                paper_bgcolor: '#ffffff',
                font: {family: "'JetBrains Mono', 'Outfit', sans-serif", color: '#0f172a', size: 9.5}
            }, {responsive: true});

            // Outlier Table
            const tbodyOutliers = document.getElementById('tbody-eda-outliers');
            if (tbodyOutliers) {
                let html = '';
                DASHBOARD_DATA.eda_outliers.forEach(o => {
                    const badgeClass = o.outlier_pct > 5.0 ? 'badge-neon-coral' : 'badge-neon-green';
                    html += `<tr>
                        <td><strong>${o.name_thai}</strong></td>
                        <td>${o.median}</td>
                        <td>[${o.q1}, ${o.q3}]</td>
                        <td><code>${o.skewness}</code></td>
                        <td><span class="${badgeClass}">${o.outlier_count} (${o.outlier_pct}%)</span></td>
                    </tr>`;
                });
                tbodyOutliers.innerHTML = html;
            }
        }

        // ---------------------------------------------------------------------
        // STEP 4: 4 CATEGORIZED MODEL TABLES & DIAGNOSTIC VISUALS
        // ---------------------------------------------------------------------
        function initStep4() {
            // Render Table B: Supervised ML Leaderboard
            const tbB = document.getElementById('tbody-table-b');
            const dataB = DASHBOARD_DATA.table_b_supervised;
            if (tbB && dataB) {
                let htmlB = '';
                dataB.forEach(row => {
                    htmlB += `<tr>
                        <td>
                            <strong class="text-dark">${row.model}</strong>
                            <div><span class="${row.badge_color} mt-1">${row.badge}</span></div>
                        </td>
                        <td><span class="code-chip">${row.paradigm}</span></td>
                        <td><strong class="text-success fs-6">${row.macro_roc_auc}</strong></td>
                        <td><strong class="text-dark">${row.accuracy}</strong></td>
                        <td>${row.precision}</td>
                        <td>${row.recall}</td>
                        <td><strong class="text-primary fs-6">${row.f1_score}</strong></td>
                        <td><code>${row.latency}</code></td>
                        <td><span class="badge-neon-green">${row.clinical_status}</span></td>
                    </tr>`;
                });
                tbB.innerHTML = htmlB;
            }

            // Render Table C: Deep Learning 1D Waveforms
            const tbC = document.getElementById('tbody-table-c');
            const dataC = DASHBOARD_DATA.table_c_deeplearning;
            if (tbC && dataC) {
                let htmlC = '';
                dataC.forEach(row => {
                    htmlC += `<tr>
                        <td>
                            <strong class="text-dark">${row.architecture}</strong>
                            <div><span class="${row.badge_color} mt-1">${row.badge}</span></div>
                        </td>
                        <td><code class="text-danger">${row.val_loss}</code></td>
                        <td><strong class="text-success fs-6">${row.macro_roc_auc}</strong></td>
                        <td><strong class="text-primary fs-6">${row.macro_f1}</strong></td>
                        <td><code>${row.gpu_latency}</code></td>
                        <td><span class="small font-code">${row.network_specs}</span></td>
                        <td><span class="small text-muted">${row.clinical_benefit}</span></td>
                    </tr>`;
                });
                tbC.innerHTML = htmlC;
            }

            // Render Table A: Unsupervised & Anomaly Detection
            const tbA = document.getElementById('tbody-table-a');
            const dataA = DASHBOARD_DATA.table_a_unsupervised;
            if (tbA && dataA) {
                let htmlA = '';
                dataA.forEach(row => {
                    htmlA += `<tr>
                        <td>
                            <strong class="text-dark">${row.model}</strong>
                            <div><span class="${row.badge_color} mt-1">${row.badge}</span></div>
                        </td>
                        <td><span class="code-chip">${row.paradigm}</span></td>
                        <td><code>${row.reconstruction_loss}</code></td>
                        <td><code class="text-dark">${row.cutoff_mse}</code></td>
                        <td><strong class="text-primary">${row.silhouette}</strong></td>
                        <td><strong class="text-success fs-6">${row.anomaly_rate}</strong></td>
                        <td>${row.specificity}</td>
                        <td><span class="small text-muted">${row.role_thai}</span></td>
                    </tr>`;
                });
                tbA.innerHTML = htmlA;
            }

            // Render Table D: Clinical LLM Agent Layer
            const tbD = document.getElementById('tbody-table-d');
            const dataD = DASHBOARD_DATA.table_d_llm_agent;
            if (tbD && dataD) {
                let htmlD = '';
                dataD.forEach(row => {
                    htmlD += `<tr>
                        <td>
                            <strong class="text-dark">${row.agent_name}</strong>
                            <div><span class="${row.badge_color} mt-1">${row.badge}</span></div>
                        </td>
                        <td><code>${row.prompt_tokens}</code></td>
                        <td><code>${row.response_latency}</code></td>
                        <td><strong class="text-success fs-6">${row.accuracy_rating}</strong></td>
                        <td><strong class="text-danger">${row.hallucination_risk}</strong></td>
                        <td><span class="code-chip">${row.output_format}</span></td>
                        <td><span class="small text-muted">${row.clinical_utility}</span></td>
                    </tr>`;
                });
                tbD.innerHTML = htmlD;
            }

            // Render Top 15 Features Table
            const tbFeat = document.getElementById('tbody-top15-features');
            const feats15 = DASHBOARD_DATA.top_15_ranked_features;
            if (tbFeat && feats15) {
                let htmlFeat = '';
                feats15.forEach(f => {
                    htmlFeat += `<tr>
                        <td class="font-code fw-bold text-center">${f.rank}</td>
                        <td><code class="text-primary">${f.feature}</code></td>
                        <td><strong>${f.thai_name}</strong></td>
                        <td><strong class="text-success font-code">${f.gain.toFixed(1)}</strong></td>
                        <td><span class="badge-neon-blue">${f.category}</span></td>
                        <td><span class="small text-muted">${f.rationale}</span></td>
                    </tr>`;
                });
                tbFeat.innerHTML = htmlFeat;
            }

            // Autoencoder Anomaly Detection Plot
            const ae = DASHBOARD_DATA.autoencoder;
            if (ae) {
                Plotly.newPlot('chart-autoencoder-anomaly', [
                    {
                        x: ae.normal_hist.bins,
                        y: ae.normal_hist.density,
                        type: 'scatter',
                        mode: 'lines',
                        fill: 'tozeroy',
                        name: 'คลื่นหัวใจปกติ (Normal Sinus Rhythm)',
                        line: {color: '#10b981', width: 2.2},
                        fillcolor: 'rgba(16, 185, 129, 0.15)'
                    },
                    {
                        x: ae.abnormal_hist.bins,
                        y: ae.abnormal_hist.density,
                        type: 'scatter',
                        mode: 'lines',
                        fill: 'tozeroy',
                        name: 'คลื่นหัวใจผิดปกติ (Cardiac Pathology / Anomalies)',
                        line: {color: '#f43f5e', width: 2.2},
                        fillcolor: 'rgba(244, 63, 94, 0.15)'
                    }
                ], {
                    shapes: [{
                        type: 'line',
                        x0: ae.threshold,
                        x1: ae.threshold,
                        y0: 0,
                        y1: 40,
                        line: {color: '#0f172a', width: 2, dash: 'dash'}
                    }],
                    annotations: [{
                        x: ae.threshold,
                        y: 36,
                        text: `จุดตัด Anomaly Cutoff (${ae.threshold} MSE)`,
                        showarrow: true,
                        arrowhead: 2,
                        font: {family: 'JetBrains Mono', size: 10, color: '#0f172a'}
                    }],
                    margin: {t: 20, b: 35, l: 45, r: 20},
                    paper_bgcolor: '#ffffff',
                    plot_bgcolor: '#f8fafc',
                    font: {family: "'JetBrains Mono', 'Outfit', sans-serif", color: '#0f172a', size: 10},
                    xaxis: {title: 'ความคลาดเคลื่อนการฟื้นฟูสัญญาณ (Reconstruction Error MSE)', gridcolor: '#f1f5f9'},
                    yaxis: {title: 'ความหนาแน่นสัมพัทธ์ (%)', gridcolor: '#f1f5f9'},
                    legend: {x: 0.35, y: 0.95, bgcolor: 'rgba(255,255,255,0.92)'}
                }, {responsive: true});
            }

            // K-Means & PCA Morphological Clustering Scatter Plot
            const cl = DASHBOARD_DATA.clustering;
            if (cl) {
                const clusterTraces = [];
                const clMeta = cl.clusters_meta;

                for (let c = 0; c < 5; c++) {
                    const cPts = cl.points.filter(p => p.cluster === c);
                    const meta = clMeta[String(c)];
                    clusterTraces.push({
                        x: cPts.map(p => p.pc1),
                        y: cPts.map(p => p.pc2),
                        mode: 'markers',
                        type: 'scatter',
                        name: meta.name.split(':')[0],
                        marker: {color: meta.color, size: 7, opacity: 0.8},
                        text: cPts.map(p => `ECG #${p.ecg_id} (Pt #${p.patient_id})<br>การวินิจฉัยจริง: ${p.diagnosis}<br>HR: ${p.hr} bpm | QRS: ${p.qrs} ms | ST: ${p.st} mV`),
                        hoverinfo: 'text'
                    });
                }

                Plotly.newPlot('chart-morph-clusters', clusterTraces, {
                    margin: {t: 20, b: 35, l: 45, r: 20},
                    paper_bgcolor: '#ffffff',
                    plot_bgcolor: '#f8fafc',
                    font: {family: "'JetBrains Mono', 'Outfit', sans-serif", color: '#0f172a', size: 10},
                    xaxis: {title: `องค์ประกอบหลักที่ 1 (PC1: ${cl.explained_variance[0]}%)`, gridcolor: '#f1f5f9'},
                    yaxis: {title: `องค์ประกอบหลักที่ 2 (PC2: ${cl.explained_variance[1]}%)`, gridcolor: '#f1f5f9'},
                    legend: {x: 0.01, y: 0.99, bgcolor: 'rgba(255,255,255,0.92)'}
                }, {responsive: true});
            }

            // GroupKFold Isolation Diagram
            const gkf = DASHBOARD_DATA.groupkfold_diagram;
            const foldsX = gkf.folds.map(f => 'Fold ' + f.fold);
            const trainPatients = gkf.folds.map(f => f.train_pts);
            const valPatients = gkf.folds.map(f => f.val_pts);

            Plotly.newPlot('chart-groupkfold-diagram', [
                {
                    x: foldsX,
                    y: trainPatients,
                    name: 'ผู้ป่วยชุดฝึกสอน Train Pts (80%)',
                    type: 'bar',
                    marker: {color: '#0284c7'}
                },
                {
                    x: foldsX,
                    y: valPatients,
                    name: 'ผู้ป่วยชุดทดสอบ Val Pts (20%)',
                    type: 'bar',
                    marker: {color: '#10b981'}
                }
            ], {
                barmode: 'stack',
                margin: {t: 20, b: 35, l: 65, r: 20},
                paper_bgcolor: '#ffffff',
                plot_bgcolor: '#f8fafc',
                font: {family: "'JetBrains Mono', 'Outfit', sans-serif", color: '#0f172a', size: 11},
                yaxis: {title: 'จำนวนผู้ป่วย (คน)', gridcolor: '#f1f5f9'},
                legend: {x: 0.55, y: 1.15, orientation: 'h'}
            }, {responsive: true});

            // Multi-Class ROC Curves
            const roc = DASHBOARD_DATA.roc_curves;
            const rocTraces = [];
            const rocColors = {'NORM': '#10b981', 'MI': '#f43f5e', 'STTC': '#f59e0b', 'CD': '#8b5cf6', 'HYP': '#14b8a6'};

            for (const [cls, cData] of Object.entries(roc)) {
                rocTraces.push({
                    x: cData.fpr,
                    y: cData.tpr,
                    type: 'scatter',
                    mode: 'lines',
                    name: `${cls} (AUC = ${cData.auc.toFixed(3)})`,
                    line: {color: rocColors[cls] || '#0284c7', width: 2.2}
                });
            }

            rocTraces.push({
                x: [0, 1],
                y: [0, 1],
                type: 'scatter',
                mode: 'lines',
                name: 'เกณฑ์สุ่ม (Chance 0.50)',
                line: {color: '#94a3b8', width: 1, dash: 'dash'}
            });

            Plotly.newPlot('chart-roc-curves', rocTraces, {
                margin: {t: 20, b: 40, l: 50, r: 20},
                paper_bgcolor: '#ffffff',
                plot_bgcolor: '#f8fafc',
                font: {family: "'JetBrains Mono', 'Outfit', sans-serif", color: '#0f172a', size: 10},
                xaxis: {title: 'False Positive Rate (1 - Specificity)', gridcolor: '#f1f5f9', range: [-0.02, 1.02]},
                yaxis: {title: 'True Positive Rate (Sensitivity)', gridcolor: '#f1f5f9', range: [-0.02, 1.02]},
                legend: {x: 0.50, y: 0.15, bgcolor: 'rgba(255,255,255,0.92)'}
            }, {responsive: true});

            // Normalized Confusion Matrix Heatmap
            const cm = DASHBOARD_DATA.conf_matrix;
            Plotly.newPlot('chart-confusion-matrix', [{
                z: cm.normalized,
                x: cm.labels,
                y: cm.labels,
                type: 'heatmap',
                colorscale: [
                    [0, '#f0f9ff'],
                    [0.5, '#7dd3fc'],
                    [1, '#0284c7']
                ],
                colorbar: {thickness: 12, title: 'สัดส่วน', tickfont: {family: 'JetBrains Mono', color: '#0f172a'}},
                text: cm.normalized.map(row => row.map(v => (v * 100).toFixed(1) + '%')),
                texttemplate: '%{text}',
                textfont: {family: 'JetBrains Mono', color: '#0f172a', size: 11}
            }], {
                margin: {t: 20, b: 50, l: 60, r: 20},
                paper_bgcolor: '#ffffff',
                plot_bgcolor: '#f8fafc',
                font: {family: "'JetBrains Mono', 'Outfit', sans-serif", color: '#0f172a', size: 11},
                xaxis: {title: 'ผลการทำนายของโมเดล (Predicted Class)'},
                yaxis: {title: 'ผลการวินิจฉัยจริง (True Class)'}
            }, {responsive: true});

            // Feature Importance Chart
            const topFeats = DASHBOARD_DATA.top_features.slice(0, 15).reverse();
            Plotly.newPlot('chart-feature-importance', [{
                x: topFeats.map(f => f.gain),
                y: topFeats.map(f => f.feature),
                type: 'bar',
                orientation: 'h',
                marker: {color: '#0284c7', line: {color: '#cbd5e1', width: 1}}
            }], {
                margin: {t: 10, b: 35, l: 230, r: 20},
                paper_bgcolor: '#ffffff',
                plot_bgcolor: '#f8fafc',
                font: {family: "'JetBrains Mono', 'Outfit', sans-serif", color: '#0f172a', size: 10},
                xaxis: {title: 'คะแนนความสำคัญ (Feature Importance Gain)', gridcolor: '#f1f5f9'}
            }, {responsive: true});
        }

        // ---------------------------------------------------------------------
        // STEP 5: PATIENT LONGITUDINAL VIEW & SIMULATOR
        // ---------------------------------------------------------------------
        function initStep5() {
            const pSelect = document.getElementById('select-patient-id');
            if (pSelect) {
                pSelect.innerHTML = '';
                for (const [pid, p] of Object.entries(DASHBOARD_DATA.patient_longitudinal_data)) {
                    const opt = document.createElement('option');
                    opt.value = pid;
                    opt.textContent = `ผู้ป่วย #${pid} (${p.total_encounters} รอบตรวจ | ${p.date_range})`;
                    pSelect.appendChild(opt);
                }
                pSelect.value = currentPatientId;
            }
            loadSelectedPatientTimeline();
        }

        function loadSelectedPatientTimeline() {
            currentPatientId = document.getElementById('select-patient-id').value;
            const pData = DASHBOARD_DATA.patient_longitudinal_data[currentPatientId];
            if (!pData) return;

            document.getElementById('info-patient-demographics').textContent =
                `ผู้ป่วย #${pData.patient_id} | อายุ ${pData.age} ปี | เพศ: ${pData.sex}`;
            document.getElementById('badge-patient-enc-count').textContent =
                `${pData.total_encounters} รอบการตรวจ`;

            // Full-Width Patient Chronological Visit Timeline Chart
            const encs = pData.encounters;
            const timeDates = encs.map(e => e.date);
            const classColors = {'NORM': '#10b981', 'MI': '#f43f5e', 'STTC': '#f59e0b', 'CD': '#8b5cf6', 'HYP': '#14b8a6'};
            const ptColors = encs.map(e => classColors[e.predicted_class] || '#0284c7');
            const ptConf = encs.map(e => (e.probabilities[e.predicted_class] * 100).toFixed(1));
            const ptHover = encs.map(e => `รอบตรวจ ECG #${e.ecg_id}<br>วันที่: ${e.date}<br>ผลทำนาย: ${e.predicted_class} (${(e.probabilities[e.predicted_class]*100).toFixed(1)}%)<br>สภาวะ: ${e.is_diseased ? 'เป็นโรคหัวใจ 🔴' : 'ปกติ 🟢'}<br>HR: ${e.metrics.heart_rate_bpm} bpm | ST: ${e.metrics.st_elevation_mv} mV`);

            Plotly.newPlot('chart-patient-visit-timeline', [{
                x: timeDates,
                y: encs.map((e, idx) => idx + 1),
                mode: 'lines+markers+text',
                type: 'scatter',
                text: encs.map(e => `${e.predicted_class} (#${e.ecg_id})`),
                textposition: 'top center',
                textfont: {family: 'JetBrains Mono', size: 10, color: '#0f172a'},
                marker: {
                    size: 14,
                    color: ptColors,
                    line: {color: '#ffffff', width: 2}
                },
                line: {color: '#94a3b8', width: 2, dash: 'dot'},
                hoverinfo: 'text',
                hovertext: ptHover
            }], {
                margin: {t: 25, b: 35, l: 60, r: 40},
                paper_bgcolor: '#ffffff',
                plot_bgcolor: '#f8fafc',
                font: {family: "'JetBrains Mono', 'Outfit', sans-serif", color: '#0f172a', size: 11},
                xaxis: {title: 'วันและเวลาที่บันทึกคลื่นไฟฟ้าหัวใจ (Recording Timeline)', gridcolor: '#f1f5f9'},
                yaxis: {
                    title: 'ลำดับรอบการตรวจ',
                    tickvals: encs.map((_, idx) => idx + 1),
                    ticktext: encs.map((_, idx) => `ครั้งที่ ${idx + 1}`),
                    gridcolor: '#f1f5f9'
                }
            }, {responsive: true});

            // Add interactive click listener to timeline chart
            const timelineChartEl = document.getElementById('chart-patient-visit-timeline');
            if (timelineChartEl) {
                timelineChartEl.on('plotly_click', function(data) {
                    if (data.points && data.points.length > 0) {
                        const ptIdx = data.points[0].pointIndex;
                        if (encs[ptIdx]) {
                            selectEncounter(encs[ptIdx].ecg_id);
                        }
                    }
                });
            }

            // Timeline Nodes Pills
            const container = document.getElementById('container-timeline-nodes');
            container.innerHTML = '';

            encs.forEach((enc, idx) => {
                const col = document.createElement('div');
                col.className = 'col-md-3 col-sm-6';

                const isDiseased = enc.is_diseased;
                const statusBadge = isDiseased ?
                    '<span class="badge-neon-coral">🔴 เป็นโรคหัวใจ</span>' :
                    '<span class="badge-neon-green">🟢 สัญญาณปกติ</span>';

                col.innerHTML = `
                    <div class="encounter-node ${idx === 0 ? 'selected' : ''}" id="node-enc-${enc.ecg_id}" onclick="selectEncounter('${enc.ecg_id}')">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="font-code text-primary">ECG #${enc.ecg_id}</strong>
                            <small class="text-muted font-code">${enc.date}</small>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <div>${statusBadge}</div>
                            <span class="code-chip">${enc.predicted_class} (${enc.confidence}%)</span>
                        </div>
                    </div>
                `;
                container.appendChild(col);
            });

            if (pData.encounters.length > 0) {
                selectEncounter(pData.encounters[0].ecg_id);
            }
        }

        function selectEncounter(ecgId) {
            currentEncounterId = parseInt(ecgId);

            document.querySelectorAll('.encounter-node').forEach(n => n.classList.remove('selected'));
            const activeNode = document.getElementById('node-enc-' + ecgId);
            if (activeNode) activeNode.classList.add('selected');

            const pData = DASHBOARD_DATA.patient_longitudinal_data[currentPatientId];
            if (!pData) return;
            const enc = pData.encounters.find(e => e.ecg_id === currentEncounterId);
            if (!enc) return;

            // 1. UPDATE INSTANT DIAGNOSTIC BANNER (2 CLINICAL GOALS INSTANTLY)
            const banner = document.getElementById('banner-diagnostic-status');
            const iconStatus = document.getElementById('icon-diagnostic-status');
            const textDiseased = document.getElementById('text-diagnostic-diseased');
            const textCondition = document.getElementById('text-diagnostic-condition-class');

            const isDiseased = enc.is_diseased;

            const classThaiDescriptions = {
                'NORM': 'NORM: สัญญาณคลื่นไฟฟ้าหัวใจปกติ (Normal Sinus Rhythm) - จังหวะและสัณฐานคลื่นสมบูรณ์',
                'MI': 'MI: ภาวะกล้ามเนื้อหัวใจขาดเลือดเฉียบพลัน (Acute Myocardial Infarction / STEMI) - มีความเสี่ยงวิกฤต',
                'STTC': 'STTC: ความผิดปกติของช่วง ST และคลื่น T (ST/T Morphological Changes) - บ่งชี้ภาวะเลือดไปเลี้ยงกล้ามเนื้อหัวใจบกพร่อง',
                'CD': 'CD: ความผิดปกติของการนำสัญญาณไฟฟ้าหัวใจ (Conduction Disturbance / Heart Block) - ไฟฟ้าเดินทางช้ากว่าเกณฑ์',
                'HYP': 'HYP: ภาวะกล้ามเนื้อหัวใจหนาตัวหรือหัวใจโต (Ventricular Hypertrophy เช่น LVH, RVH) - ผนังหัวใจหนาตัวขึ้น'
            };

            if (!isDiseased) {
                banner.className = 'diag-banner diag-banner-normal';
                iconStatus.textContent = '🟢';
                textDiseased.textContent = 'ผู้ป่วยเป็นโรคหัวใจหรือไม่? → ปกติ (ไม่พบภาวะโรคหัวใจ - DISEASE FREE)';
            } else {
                banner.className = 'diag-banner diag-banner-abnormal';
                iconStatus.textContent = '🔴';
                textDiseased.textContent = 'ผู้ป่วยเป็นโรคหัวใจหรือไม่? → ผิดปกติ (ตรวจพบภาวะโรคหัวใจ - CARDIAC PATHOLOGY DETECTED)';
            }

            textCondition.innerHTML = `เป็นโรคหัวใจชนิดไหน? (5 Superclasses: NORM, MI, STTC, CD, HYP) → <strong>${classThaiDescriptions[enc.predicted_class] || enc.predicted_class}</strong>`;

            const maxP = Math.max(...Object.values(enc.probabilities));
            document.getElementById('label-ai-confidence').textContent = (maxP * 100).toFixed(1) + '%';
            document.getElementById('badge-encounter-id-tag').textContent = `รอบการตรวจ ECG #${enc.ecg_id} (${enc.date})`;

            // 2. PREDICTED PROBABILITIES BAR CHART
            const clsKeys = Object.keys(enc.probabilities);
            const clsVals = Object.values(enc.probabilities).map(p => (p * 100).toFixed(1));
            const classColors = {'NORM': '#10b981', 'MI': '#f43f5e', 'STTC': '#f59e0b', 'CD': '#8b5cf6', 'HYP': '#14b8a6'};

            Plotly.newPlot('chart-prediction-bars', [{
                y: clsKeys,
                x: clsVals,
                type: 'bar',
                orientation: 'h',
                marker: {
                    color: clsKeys.map(c => classColors[c] || '#0284c7'),
                    line: {color: '#cbd5e1', width: 1}
                },
                text: clsVals.map(v => v + '%'),
                textposition: 'outside'
            }], {
                margin: {t: 10, b: 30, l: 60, r: 40},
                paper_bgcolor: '#ffffff',
                plot_bgcolor: '#f8fafc',
                font: {family: "'JetBrains Mono', 'Outfit', sans-serif", color: '#0f172a', size: 11},
                xaxis: {title: 'ความน่าจะเป็น (Probability %)', range: [0, 105], gridcolor: '#f1f5f9'}
            }, {responsive: true});

            // 3. CLINICAL BIOMARKERS GRID
            const grid = document.getElementById('grid-encounter-biomarkers');
            if (grid) {
                const m = enc.metrics;
                grid.innerHTML = `
                    <div class="col-4">
                        <div class="p-2 rounded-3 bg-light border">
                            <div class="small text-muted font-code">อัตราเต้นเฉลี่ย HR</div>
                            <div class="fw-bold text-danger fs-5">${m.heart_rate_bpm} <span style="font-size: 0.65rem;">bpm</span></div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 rounded-3 bg-light border">
                            <div class="small text-muted font-code">ความแปรปรวน SDNN</div>
                            <div class="fw-bold text-info fs-5">${m.sdnn_ms} <span style="font-size: 0.65rem;">ms</span></div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 rounded-3 bg-light border">
                            <div class="small text-muted font-code">เวกัสโทน RMSSD</div>
                            <div class="fw-bold text-primary fs-5">${m.rmssd_ms} <span style="font-size: 0.65rem;">ms</span></div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 rounded-3 bg-light border">
                            <div class="small text-muted font-code">ความกว้างคลื่น QRS</div>
                            <div class="fw-bold ${m.qrs_ms > 110 ? 'text-danger' : 'text-success'} fs-5">${m.qrs_ms} <span style="font-size: 0.65rem;">ms</span></div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 rounded-3 bg-light border">
                            <div class="small text-muted font-code">การยกตัวคลื่น ST</div>
                            <div class="fw-bold ${m.st_elevation_mv > 0.1 ? 'text-danger' : 'text-success'} fs-5">${m.st_elevation_mv} <span style="font-size: 0.65rem;">mV</span></div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 rounded-3 bg-light border">
                            <div class="small text-muted font-code">ระยะคลื่น Bazett QTc</div>
                            <div class="fw-bold text-warning fs-5">${m.qtc_ms} <span style="font-size: 0.65rem;">ms</span></div>
                        </div>
                    </div>
                `;
            }

            // 4. DETAILED CLINICAL METRICS TABLE
            const tbodyMetrics = document.getElementById('tbody-encounter-metrics-table');
            if (tbodyMetrics && enc.clinical_metrics_table) {
                let html = '';
                enc.clinical_metrics_table.forEach(row => {
                    html += `<tr>
                        <td><strong>${row.metric}</strong></td>
                        <td><strong class="font-code fs-6 text-dark">${row.value}</strong></td>
                        <td><span class="code-chip">${row.unit}</span></td>
                        <td>${row.normal_range}</td>
                        <td>${row.interpretation}</td>
                        <td><span class="${row.badge_class}">${row.status}</span></td>
                    </tr>`;
                });
                tbodyMetrics.innerHTML = html;
            }

            // 5. LLM CLINICAL NARRATIVE SUMMARY BOX
            const llmContainer = document.getElementById('container-llm-narrative-content');
            const riskBadge = document.getElementById('badge-llm-risk-level');
            if (llmContainer && enc.llm_narrative) {
                const n = enc.llm_narrative;
                if (riskBadge) {
                    riskBadge.textContent = n.clinical_risk_level;
                    riskBadge.className = n.risk_badge_color === 'danger' ? 'badge-neon-coral' : (n.risk_badge_color === 'warning' ? 'badge-neon-teal' : 'badge-neon-green');
                }

                let recHtml = '';
                n.recommendations.forEach(r => {
                    recHtml += `<li class="mb-1">${r}</li>`;
                });

                let cotHtml = '';
                n.cot_reasoning.forEach(c => {
                    cotHtml += `<div class="font-code small text-muted mb-1">${c}</div>`;
                });

                llmContainer.innerHTML = `
                    <div class="p-3 rounded-4 bg-light border mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold text-dark mb-0 font-code"><i class="fas fa-stethoscope text-primary me-2"></i> สรุปผลการประเมินทางคลินิก (Clinical Impression):</h6>
                            <span class="code-chip">บันทึกอัตโนมัติประจำรอบ ECG #${enc.ecg_id}</span>
                        </div>
                        <p class="mb-0 text-dark" style="line-height: 1.6;">${n.encounter_summary}</p>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="p-3 rounded-4 bg-white border h-100">
                                <div class="fw-bold text-primary mb-1 small font-code"><i class="fas fa-wave-square me-1"></i> การวิเคราะห์สัณฐานวิทยาคลื่นไฟฟ้า (Morphology):</div>
                                <div class="small text-muted" style="line-height: 1.5;">${n.morphology_evaluation}</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded-4 bg-white border h-100">
                                <div class="fw-bold text-teal mb-1 small font-code"><i class="fas fa-heart-pulse me-1"></i> ระบบประสาทอัตโนมัติและความแปรปรวน (HRV Tone):</div>
                                <div class="small text-muted" style="line-height: 1.5;">${n.autonomic_evaluation}</div>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 rounded-4 bg-white border mb-3">
                        <div class="fw-bold text-danger mb-2 small font-code"><i class="fas fa-clipboard-list-check me-1"></i> คำแนะนำและแผนการดูแลรักษาทางอายุรศาสตร์ (Clinical Recommendations):</div>
                        <ul class="mb-0 ps-3 small text-dark">
                            ${recHtml}
                        </ul>
                    </div>

                    <details class="p-2 rounded bg-light border">
                        <summary class="small font-code text-muted cursor-pointer"><i class="fas fa-microchip me-1"></i> แสดงกระบวนการให้เหตุผลระดับลึกของ AI (Chain-of-Thought Traces)</summary>
                        <div class="p-2 mt-2 bg-white rounded border">
                            ${cotHtml}
                        </div>
                    </details>
                `;
            }

            updateEncounterWaveformView();
            updateShapChartView(enc);

            // Sync Sliders to current encounter
            document.getElementById('slider-st-elevation').value = enc.metrics.st_elevation_mv || 0.0;
            document.getElementById('slider-heart-rate').value = enc.metrics.heart_rate_bpm || 72;
            document.getElementById('slider-qrs-duration').value = enc.metrics.qrs_ms || 88;
            runWhatIfSimulation();
        }

        function updateEncounterWaveformView() {
            const lead = document.getElementById('select-encounter-lead').value;
            const pData = DASHBOARD_DATA.patient_longitudinal_data[currentPatientId];
            if (!pData) return;
            const enc = pData.encounters.find(e => e.ecg_id === currentEncounterId);
            if (!enc) return;

            const sig = enc.leads[lead] || [];
            const timeAxis = Array.from({length: sig.length}, (_, i) => (i * 0.02).toFixed(2));

            const traceSig = {
                x: timeAxis,
                y: sig,
                type: 'scatter',
                mode: 'lines',
                name: `ลีด ${lead}`,
                line: {color: '#10b981', width: 2.2}
            };

            const traces = [traceSig];
            if (lead === 'II' && enc.r_peaks) {
                const peakX = enc.r_peaks.map(idx => timeAxis[idx]);
                const peakY = enc.r_peaks.map(idx => sig[idx]);
                traces.push({
                    x: peakX,
                    y: peakY,
                    type: 'scatter',
                    mode: 'markers',
                    name: 'ยอด R-Peaks',
                    marker: {color: '#0284c7', size: 8}
                });
            }

            const shapes = [];
            if (enc.metrics.st_elevation_mv > 0.08 || enc.predicted_class === 'MI') {
                enc.r_peaks.slice(0, 5).forEach(pk => {
                    const stStart = pk + 3;
                    const stEnd = pk + 8;
                    if (stEnd < timeAxis.length) {
                        shapes.push({
                            type: 'rect',
                            x0: timeAxis[stStart],
                            x1: timeAxis[stEnd],
                            y0: -0.2,
                            y1: 0.6,
                            fillcolor: 'rgba(244, 63, 94, 0.20)',
                            line: {color: 'rgba(244, 63, 94, 0.6)', width: 1}
                        });
                    }
                });
            }

            Plotly.newPlot('chart-encounter-waveform-xai', traces, {
                shapes: shapes,
                margin: {t: 20, b: 35, l: 50, r: 20},
                paper_bgcolor: '#ffffff',
                plot_bgcolor: '#f8fafc',
                font: {family: "'JetBrains Mono', 'Outfit', sans-serif", color: '#0f172a', size: 11},
                xaxis: {title: 'เวลา (วินาที - Seconds)', gridcolor: '#f1f5f9'},
                yaxis: {title: 'แรงดันไฟฟ้า (มิลลิโวลต์ - mV)', gridcolor: '#f1f5f9'},
                legend: {x: 0.01, y: 0.99, bgcolor: 'rgba(255,255,255,0.92)'}
            }, {responsive: true});
        }

        function updateShapChartView(enc) {
            const shapList = enc.shap_top || [];
            const yNames = shapList.map(s => s.feature).reverse();
            const xVals = shapList.map(s => s.shap).reverse();
            const colors = xVals.map(v => v >= 0 ? '#10b981' : '#f43f5e');

            Plotly.newPlot('chart-local-shap', [{
                y: yNames,
                x: xVals,
                type: 'bar',
                orientation: 'h',
                marker: {color: colors, line: {color: '#cbd5e1', width: 1}},
                text: xVals.map(v => (v > 0 ? '+' : '') + v.toFixed(3)),
                textposition: 'outside'
            }], {
                margin: {t: 10, b: 35, l: 190, r: 35},
                paper_bgcolor: '#ffffff',
                plot_bgcolor: '#f8fafc',
                font: {family: "'JetBrains Mono', 'Outfit', sans-serif", color: '#0f172a', size: 10},
                xaxis: {title: `คะแนนผลักดัน SHAP ต่อกลุ่ม ${enc.predicted_class}`, gridcolor: '#f1f5f9'}
            }, {responsive: true});
        }

        function runWhatIfSimulation() {
            const stVal = parseFloat(document.getElementById('slider-st-elevation').value);
            const hrVal = parseInt(document.getElementById('slider-heart-rate').value);
            const qrsVal = parseInt(document.getElementById('slider-qrs-duration').value);

            document.getElementById('label-slider-st').textContent = (stVal > 0 ? '+' : '') + stVal.toFixed(2) + ' mV';
            document.getElementById('label-slider-hr').textContent = hrVal + ' bpm';
            document.getElementById('label-slider-qrs').textContent = qrsVal + ' ms';

            const pData = DASHBOARD_DATA.patient_longitudinal_data[currentPatientId];
            if (!pData) return;
            const enc = pData.encounters.find(e => e.ecg_id === currentEncounterId);
            if (!enc) return;

            let baseP = {...enc.probabilities};

            let miMultiplier = Math.exp(7.5 * (stVal - enc.metrics.st_elevation_mv));
            let cdMultiplier = Math.exp(0.045 * (qrsVal - enc.metrics.qrs_ms));
            let hrRisk = (hrVal > 100) ? (1.0 + (hrVal - 100) * 0.015) : (hrVal < 60 ? 1.15 : 1.0);

            let simScores = {
                'CD': baseP['CD'] * cdMultiplier * (hrVal < 55 ? 1.3 : 1.0),
                'HYP': baseP['HYP'],
                'MI': baseP['MI'] * miMultiplier * hrRisk,
                'NORM': baseP['NORM'] / Math.max(0.2, miMultiplier * 0.7 + (hrVal > 120 ? 1.5 : 0.8)),
                'STTC': baseP['STTC'] * (stVal > 0.05 ? 1.6 : (stVal < -0.05 ? 1.8 : 1.0)) * hrRisk,
            };

            let tot = Object.values(simScores).reduce((a, b) => a + b, 0);
            let simP = {};
            for (const [k, v] of Object.entries(simScores)) {
                simP[k] = (v / tot) * 100;
            }

            // Dynamic Estimated Patient Disease Risk Score (%) = 100% - P(NORM)
            let diseaseRiskScore = Math.min(99.9, Math.max(0.1, 100.0 - simP['NORM']));
            const valRiskEl = document.getElementById('val-what-if-risk-score');
            const badgeRiskEl = document.getElementById('badge-what-if-risk-status');

            if (valRiskEl) {
                valRiskEl.textContent = diseaseRiskScore.toFixed(1) + '%';
                if (diseaseRiskScore >= 65.0 || stVal >= 0.15) {
                    valRiskEl.className = 'fs-2 fw-bold font-code text-danger';
                } else if (diseaseRiskScore >= 35.0) {
                    valRiskEl.className = 'fs-2 fw-bold font-code text-warning';
                } else {
                    valRiskEl.className = 'fs-2 fw-bold font-code text-success';
                }
            }

            if (badgeRiskEl) {
                if (diseaseRiskScore >= 65.0 || stVal >= 0.15) {
                    badgeRiskEl.className = 'badge fs-6 py-2 px-3 badge-neon-coral';
                    badgeRiskEl.innerHTML = 'วิกฤตฉุกเฉิน (High Critical Risk) 🔴';
                } else if (diseaseRiskScore >= 35.0) {
                    badgeRiskEl.className = 'badge fs-6 py-2 px-3 badge-neon-blue';
                    badgeRiskEl.innerHTML = 'ความเสี่ยงปานกลาง (Moderate Risk) 🟡';
                } else {
                    badgeRiskEl.className = 'badge fs-6 py-2 px-3 badge-neon-green';
                    badgeRiskEl.innerHTML = 'ความเสี่ยงต่ำ - ปกติ (Low Risk) 🟢';
                }
            }

            const classes = DASHBOARD_DATA.class_names;
            const baseVals = classes.map(c => ((baseP[c] || 0) * 100).toFixed(1));
            const simVals = classes.map(c => simP[c].toFixed(1));

            Plotly.newPlot('chart-what-if-comparison', [
                {
                    x: classes,
                    y: baseVals,
                    name: 'ค่าจากการตรวจจริง (Baseline)',
                    type: 'bar',
                    marker: {color: '#94a3b8'}
                },
                {
                    x: classes,
                    y: simVals,
                    name: 'ค่าจำลองสภาวะ (Simulated)',
                    type: 'bar',
                    marker: {color: '#0284c7'}
                }
            ], {
                barmode: 'group',
                margin: {t: 15, b: 30, l: 40, r: 20},
                paper_bgcolor: '#ffffff',
                plot_bgcolor: '#f8fafc',
                font: {family: "'JetBrains Mono', 'Outfit', sans-serif", color: '#0f172a', size: 10},
                yaxis: {title: 'ความน่าจะเป็น (%)', range: [0, 100], gridcolor: '#f1f5f9'},
                legend: {x: 0.5, y: 1.18, orientation: 'h'}
            }, {responsive: true});

            const alertBox = document.getElementById('alert-what-if-feedback');
            if (stVal >= 0.15) {
                alertBox.className = 'alert alert-danger py-2 px-3 mt-2 mb-0 small';
                alertBox.innerHTML = `⚠️ <strong>แจ้งเตือนภาวะ STEMI ฉุกเฉิน:</strong> การยกตัวของช่วง ST (${(stVal >= 0 ? '+' : '') + stVal.toFixed(2)} mV) ส่งผลให้ความเสี่ยงกล้ามเนื้อหัวใจขาดเลือดเฉียบพลัน (MI) พุ่งสูงถึง <strong>${simP['MI'].toFixed(1)}%</strong> คะแนนความเสี่ยงรวม <strong>${diseaseRiskScore.toFixed(1)}%</strong> แนะนำส่งต่อทำ Primary PCI ด่วน`;
            } else if (hrVal >= 130) {
                alertBox.className = 'alert alert-warning py-2 px-3 mt-2 mb-0 small';
                alertBox.innerHTML = `⚠️ <strong>แจ้งเตือนภาวะหัวใจเต้นเร็ว (Tachycardia):</strong> อัตราเต้น ${Math.round(hrVal)} bpm เพิ่มภาระงานของกล้ามเนื้อหัวใจ ส่งผลให้ความแปรปรวน Repolarization (STTC) เพิ่มเป็น <strong>${simP['STTC'].toFixed(1)}%</strong>`;
            } else if (qrsVal >= 130) {
                alertBox.className = 'alert alert-warning py-2 px-3 mt-2 mb-0 small';
                alertBox.innerHTML = `⚠️ <strong>แจ้งเตือนระบบนำไฟฟ้าขัดข้อง:</strong> คลื่น QRS กว้าง (${qrsVal} ms) ผลักดันความเสี่ยงภาวะ Conduction Disturbance (CD) เป็น <strong>${simP['CD'].toFixed(1)}%</strong>`;
            } else if (stVal < -0.05) {
                alertBox.className = 'alert alert-warning py-2 px-3 mt-2 mb-0 small';
                alertBox.innerHTML = `⚠️ <strong>ตรวจพบ ST Depression:</strong> ช่วง ST ลาดลง (${stVal.toFixed(2)} mV) บ่งชี้ภาวะ Subendocardial Ischemia ความเสี่ยงรวม <strong>${diseaseRiskScore.toFixed(1)}%</strong>`;
            } else {
                alertBox.className = 'alert alert-secondary py-2 px-3 mt-2 mb-0 small';
                alertBox.innerHTML = `ℹ️ <strong>สภาวะจำลองอยู่ในเกณฑ์ควบคุม:</strong> อัตราเต้น ${Math.round(hrVal)} bpm และช่วง ST ${(stVal >= 0 ? '+' : '') + stVal.toFixed(2)} mV ความน่าจะเป็นปกติ NORM = <strong>${simP['NORM'].toFixed(1)}%</strong> (คะแนนความเสี่ยงโรค ${diseaseRiskScore.toFixed(1)}%)`;
            }
        }

        function copyNarrativeToClipboard() {
            const pData = DASHBOARD_DATA.patient_longitudinal_data[currentPatientId];
            if (!pData) return;
            const enc = pData.encounters.find(e => e.ecg_id === currentEncounterId);
            if (!enc || !enc.llm_narrative) return;

            const n = enc.llm_narrative;
            const textToCopy = `=== บันทึกการประเมินทางคลินิกคลื่นไฟฟ้าหัวใจ (EHR Clinical Note) ===
ผู้ป่วย: #${pData.patient_id} | อายุ: ${pData.age} ปี | เพศ: ${pData.sex}
รอบการตรวจ: ECG #${enc.ecg_id} | วันที่: ${enc.date}
ผลการวินิจฉัยหลัก: ${enc.predicted_class} (ความเชื่อมั่น ${enc.confidence}%)
สภาวะโรค: ${enc.is_diseased ? 'เป็นโรคหัวใจ (ผิดปกติ)' : 'ปกติ (Disease Free)'}
ระดับความเสี่ยง: ${n.clinical_risk_level}

[ข้อสรุปการประเมินทางคลินิก]
${n.encounter_summary}

[สัณฐานวิทยาคลื่นไฟฟ้าหัวใจ]
${n.morphology_evaluation}

[ระบบประสาทอัตโนมัติ HRV]
${n.autonomic_evaluation}

[คำแนะนำและแผนการดูแลรักษา]
${n.recommendations.map((r, i) => (i + 1) + '. ' + r).join(String.fromCharCode(10))}

ลงชื่อ: AI Clinical Decision Support System (PTB-XL Intelligence Platform)`;

            navigator.clipboard.writeText(textToCopy).then(() => {
                alert('คัดลอกบันทึกการประเมินทางคลินิกลงคลิปบอร์ดสำเร็จ! สามารถนำไปวางในระบบเวชระเบียน (EHR) ได้ทันที');
            }).catch(err => {
                console.error('Could not copy text: ', err);
            });
        }
        window.copyNarrativeToClipboard = copyNarrativeToClipboard;
    </script>
</body>
</html>
