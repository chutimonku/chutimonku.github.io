8\u0e27\u0e07 ST-Segment \u0e41\u0e25\u0e30\u0e04\u0e25\u0e37\u0e48\u0e19 T (ST/T Morphological Changes) \u0e04\u0e27\u0e32\u0e21\u0e40\u0e0a\u0e37\u0e48\u0e2d\u0e21\u0e31\u0e48\u0e19 75.9% \u0e2a\u0e30\u0e17\u0e49\u0e2d\u0e19\u0e20\u0e32\u0e27\u0e30\u0e40\u0e25\u0e37\u0e2d\u0e14\u0e44\u0e1b\u0e40\u0e25\u0e35\u0e49\u0e22\u0e07\u0e01\u0e25\u0e49\u0e32\u0e21\u0e40\u0e19\u0e37\u0e49\u0e2d\u0e2b\u0e31\u0e27\u0e43\u0e08\u0e1a\u0e01\u0e1e\u0e23\u0e48\u0e2d\u0e07\u0e2b\u0e23\u0e37\u0e2d\u0e04\u0e27\u0e32\u0e21\u0e1c\u0e34\u0e14\u0e1b\u0e01\u0e15\u0e34\u0e43\u0e19\u0e01\u0e32\u0e23\u0e04\u0e25\u0e32\u0e22\u0e15\u0e31\u0e27 (Myocardial Ischemia / Strain Pattern)", "morphology_evaluation": "\u0e01\u0e32\u0e23\u0e40\u0e1b\u0e25\u0e35\u0e48\u0e22\u0e19\u0e41\u0e1b\u0e25\u0e07\u0e02\u0e2d\u0e07\u0e04\u0e25\u0e37\u0e48\u0e19 ST-T (ST Depression \u0e2b\u0e23\u0e37\u0e2d T-wave Inversion) \u0e42\u0e14\u0e22\u0e04\u0e27\u0e32\u0e21\u0e01\u0e27\u0e49\u0e32\u0e07\u0e04\u0e25\u0e37\u0e48\u0e19 QRS \u0e2d\u0e22\u0e39\u0e48\u0e17\u0e35\u0e48 100 ms \u0e41\u0e25\u0e30\u0e23\u0e30\u0e22\u0e30 QTc \u0e2d\u0e22\u0e39\u0e48\u0e17\u0e35\u0e48 383 ms \u0e2a\u0e30\u0e17\u0e49\u0e2d\u0e19\u0e01\u0e32\u0e23\u0e04\u0e25\u0e32\u0e22\u0e15\u0e31\u0e27\u0e02\u0e2d\u0e07\u0e40\u0e0b\u0e25\u0e25\u0e4c\u0e01\u0e25\u0e49\u0e32\u0e21\u0e40\u0e19\u0e37\u0e49\u0e2d\u0e2b\u0e31\u0e27\u0e43\u0e08\u0e2b\u0e49\u0e2d\u0e07\u0e25\u0e48\u0e32\u0e07\u0e1c\u0e34\u0e14\u0e1b\u0e01\u0e15\u0e34", "autonomic_evaluation": "\u0e2d\u0e31\u0e15\u0e23\u0e32\u0e40\u0e15\u0e49\u0e19\u0e2b\u0e31\u0e27\u0e43\u0e08 66 bpm, RMSSD 30.9 ms \u0e04\u0e27\u0e23\u0e15\u0e23\u0e27\u0e08\u0e41\u0e22\u0e01\u0e42\u0e23\u0e04\u0e23\u0e30\u0e2b\u0e27\u0e48\u0e32\u0e07\u0e01\u0e25\u0e49\u0e32\u0e21\u0e40\u0e19\u0e37\u0e49\u0e2d\u0e2b\u0e31\u0e27\u0e43\u0e08\u0e02\u0e32\u0e14\u0e40\u0e25\u0e37\u0e2d\u0e14\u0e40\u0e23\u0e37\u0e49\u0e2d\u0e23\u0e31\u0e07 (Chronic Ischemia) \u0e01\u0e31\u0e1a\u0e04\u0e27\u0e32\u0e21\u0e44\u0e21\u0e48\u0e2a\u0e21\u0e14\u0e38\u0e25\u0e02\u0e2d\u0e07\u0e40\u0e01\u0e25\u0e37\u0e2d\u0e41\u0e23\u0e48\u0e43\u0e19\u0e40\u0e25\u0e37\u0e2d\u0e14", "clinical_risk_level": "\u0e04\u0e27\u0e32\u0e21\u0e40\u0e2a\u0e35\u0e48\u0e22\u0e07\u0e1b\u0e32\u0e19\u0e01\u0e25\u0e32\u0e07 (Moderate Risk - Ischemia Surveillance) \ud83d\udfe1", "risk_badge_color": "warning", "recommendations": ["\u0e15\u0e23\u0e27\u0e08\u0e40\u0e25\u0e37\u0e2d\u0e14\u0e14\u0e39\u0e23\u0e30\u0e14\u0e31\u0e1a\u0e40\u0e01\u0e25\u0e37\u0e2d\u0e41\u0e23\u0e48\u0e43\u0e19\u0e23\u0e48\u0e32\u0e07\u0e01\u0e32\u0e22 (Serum Electrolytes: K+, Mg2+, Ca2+) \u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e41\u0e22\u0e01\u0e20\u0e32\u0e27\u0e30\u0e40\u0e01\u0e25\u0e37\u0e2d\u0e41\u0e23\u0e48\u0e1c\u0e34\u0e14\u0e1b\u0e01\u0e15\u0e34", "\u0e1e\u0e34\u0e08\u0e32\u0e23\u0e13\u0e32\u0e2a\u0e48\u0e07\u0e15\u0e23\u0e27\u0e08\u0e2a\u0e21\u0e23\u0e23\u0e16\u0e20\u0e32\u0e1e\u0e2b\u0e31\u0e27\u0e43\u0e08\u0e02\u0e13\u0e30\u0e2d\u0e2d\u0e01\u0e01\u0e33\u0e25\u0e31\u0e07\u0e01\u0e32\u0e22 (Exercise Stress Test) \u0e2b\u0e23\u0e37\u0e2d Coronary CT Angiography \u0e15\u0e32\u0e21\u0e2d\u0e32\u0e01\u0e32\u0e23\u0e17\u0e32\u0e07\u0e04\u0e25\u0e34\u0e19\u0e34\u0e01", "\u0e43\u0e2b\u0e49\u0e22\u0e32\u0e04\u0e27\u0e1a\u0e04\u0e38\u0e21\u0e2d\u0e31\u0e15\u0e23\u0e32\u0e01\u0e32\u0e23\u0e40\u0e15\u0e49\u0e19\u0e2b\u0e31\u0e27\u0e43\u0e08\u0e41\u0e25\u0e30\u0e22\u0e32\u0e25\u0e14\u0e01\u0e32\u0e23\u0e17\u0e33\u0e07\u0e32\u0e19\u0e02\u0e2d\u0e07\u0e01\u0e25\u0e49\u0e32\u0e21\u0e40\u0e19\u0e37\u0e49\u0e2d\u0e2b\u0e31\u0e27\u0e43\u0e08\u0e15\u0e32\u0e21\u0e02\u0e49\u0e2d\u0e1a\u0e48\u0e07\u0e0a\u0e35\u0e49\u0e17\u0e32\u0e07\u0e2d\u0e32\u0e22\u0e38\u0e23\u0e28\u0e32\u0e2a\u0e15\u0e23\u0e4c"], "cot_reasoning": ["1. \u0e01\u0e32\u0e23\u0e27\u0e34\u0e40\u0e04\u0e23\u0e32\u0e30\u0e2b\u0e4c\u0e08\u0e31\u0e07\u0e2b\u0e27\u0e30\u0e41\u0e25\u0e30\u0e2d\u0e31\u0e15\u0e23\u0e32: \u0e2d\u0e31\u0e15\u0e23\u0e32\u0e40\u0e15\u0e49\u0e19\u0e40\u0e09\u0e25\u0e35\u0e48\u0e22 66 bpm \u0e2d\u0