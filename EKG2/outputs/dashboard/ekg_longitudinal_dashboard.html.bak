                                        <!-- Dynamic JS -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ============================================================= -->
            <!-- หน้า 4: การประเมินกลุ่มแบบจำลอง (Hybrid Modeling Pool)          -->
            <!-- ============================================================= -->
            <section id="page-step-4" class="step-page">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <span class="badge-neon-green mb-1">ระยะที่ 4 (Phase 4)</span>
                        <h2 class="fw-bold mb-0 text-dark">🏆 การประเมินกลุ่มแบบจำลองไฮบริด & ลีดเดอร์บอร์ดการทำนายโรค</h2>
                    </div>
                    <div>
                        <span class="badge-neon-blue">
                            <i class="fas fa-users-slash me-1"></i> ผู้ป่วยซ้อนทับ 0% (Zero Leakage)
                        </span>
                    </div>
                </div>

                <div class="callout-box" id="sec-groupkfold">
                    <strong><i class="fas fa-shield me-1"></i> มาตรฐานการประเมินแบบจำลองป้องกันข้อมูลรั่วไหล 100% (GroupKFold Cross-Validation):</strong><br>
                    ในชุดข้อมูลที่มีการตรวจซ้ำหลายครั้ง หากแบ่งข้อมูลแบบสุ่มธรรมดา (Random Train-Test Split) จะเกิดสภาวะ <strong>Identity Memorization Leakage</strong> ที่โมเดลจดจำคลื่นไฟฟ้าของผู้ป่วยคนเดียวกันจากชุด Train ไปทำนายในชุด Test ทำให้ค่าประเมินสูงเกินจริงแต่ล้มเหลวในการใช้งานจริง
                    ระบบจึงใช้ <strong>GroupKFold 5-Fold โดยยึด <code>patient_id</code> เป็นหลัก</strong> ผู้ป่วยรายใดอยู่ใน Train จะไม่มีวันปรากฏใน Validation Set อย่างเด็ดขาด
                </div>

