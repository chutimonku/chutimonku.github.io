            <!-- ============================================================= -->
            <!-- หน้า 3: การสำรวจข้อมูล EDA & วิศวกรรมฟีเจอร์                    -->
            <!-- ============================================================= -->
            <section id="page-step-3" class="step-page">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <span class="badge-neon-purple mb-1">ระยะที่ 3 (Phase 3)</span>
                        <h2 class="fw-bold mb-0 text-dark">🔬 การสำรวจข้อมูลเชิงลึก & วิศวกรรมฟีเจอร์คลื่นไฟฟ้าหัวใจ</h2>
                    </div>
                    <div>
                        <span class="badge-neon-green">
                            <i class="fas fa-dna me-1"></i> 63 Clean Features | 0 Target Leakage
                        </span>
                    </div>
                </div>

                <!-- Clinical Beginner-Friendly Guide -->
                <div class="callout-box" id="sec-clinical-guide">
                    <strong><i class="fas fa-heart me-1"></i> คู่มือสรีรวิทยาคลื่นไฟฟ้าหัวใจเบื้องต้น (Beginner-Friendly ECG Interpretation Guide):</strong><br>
                    คลื่นไฟฟ้าหัวใจสะท้อนการเดินทางของประจุไฟฟ้าผ่านกล้ามเนื้อหัวใจ 4 ห้องในแต่ละจังหวะการเต้น ประกอบด้วย 5 คลื่นหลัก:
                    <div class="row mt-2 g-3">
                        <div class="col-md-3">
                            <strong>1. คลื่น P (P Wave):</strong>
                            <p class="small text-muted mb-0">การบีบตัวของหัวใจห้องบน (Atrial Depolarization) ความกว้างปกติไม่เกิน 120 ms หากคลื่น P ผิดปกติอาจบ่งชี้ภาวะหัวใจห้องบนสั่นพริ้ว (AFib)</p>
                        </div>
                        <div class="col-md-3">
                            <strong>2. กลุ่มคลื่น QRS (QRS Complex):</strong>
                            <p class="small text-muted mb-0">การบีบตัวของหัวใจห้องล่าง (Ventricular Depolarization) ส่งเลือดไปทั่วร่างกาย ปกติกว้าง 80–110 ms หากกว้าง &gt;120 ms บ่งชี้การนำไฟฟ้าขัดข้อง (CD / Block)</p>
                        </div>
                        <div class="col-md-3">
                            <strong>3. ช่วง ST Segment &amp; คลื่น T:</strong>
                            <p class="small text-muted mb-0">การคลายตัวของหัวใจห้องล่าง (Repolarization) หากช่วง ST ยกตัวสูงขึ้น &gt;0.1 mV บ่งชี้ภาวะกล้ามเนื้อหัวใจขาดเลือดเฉียบพลัน (STEMI)</p>
                        </div>
                        <div class="col-md-3">
                            <strong>4. ความแปรปรวนหัวใจ (HRV):</strong>
                            <p class="small text-muted mb-0">วัดความยืดหยุ่นของระบบประสาทอัตโนมัติ (SDNN และ RMSSD) ค่าที่สูงสะท้อนสุขภาพหัวใจที่ดีและระบบประสาทพาราซิมพาเทติกที่สมบูรณ์</p>
                        </div>
                    </div>
                </div>

                <!-- 12-Lead Biomedical Waveform Overlay (100% FULL WIDTH col-12) -->
                <div class="card card-custom mb-4" id="sec-pan-tompkins">
                    <div class="card-header-custom">
                        <span><i class="fas fa-chart-area me-2 text-danger"></i> กราฟคลื่นไฟฟ้าหัวใจพร้อมตรวจจับยอด R-Peak (Pan-Tompkins) และช่วงคลื่น QRS / ST (100% Full-Width Waveform Viewer)</span>
                        <span class="badge-neon-blue">ลีดจังหวะ II (Lead II Rhythm)</span>
                    </div>
                    <div class="card-body-custom">
                        <div id="chart-biomedical-overlay" style="height: 420px;"></div>
                        <div class="d-flex justify-content-between mt-2 small text-muted font-code">
                            <span><i class="fas fa-circle text-danger me-1"></i> ยอด R-Peaks (ตรวจจับโดยอัลกอริทึม Pan-Tompkins)</span>
                            <span><i class="fas fa-arrows-left-right text-info me-1"></i> กรอบความกว้างกลุ่มคลื่น QRS Complex (เริ่มต้น &rarr; สิ้นสุด: ~86 ms)</span>
                            <span><i class="fas fa-flag text-warning me-1"></i> จุดวัดการยกตัวของช่วง ST ที่จุด J+60ms เทียบกับระดับ Isopotential</span>
                        </div>
                    </div>
                </div>

                <!-- HRV Frequency Spectrum (Welch PSD) (100% FULL WIDTH col-12) -->
                <div class="card card-custom mb-4" id="sec-welch-psd">
                    <div class="card-header-custom">
                        <span><i class="fas fa-chart-line me-2 text-primary"></i> สเปกตรัมความถี่ความแปรปรวนการเต้นของหัวใจ (HRV Welch PSD Spectrum Plot — 100% Full-Width)</span>
                        <span class="badge-neon-teal" id="badge-lf-hf">LF/HF Ratio: 1.42 (สมดุลปกติ)</span>
                    </div>
                    <div class="card-body-custom">
                        <div id="chart-welch-psd" style="height: 380px;"></div>
                        <p class="small text-muted mt-2 mb-0">
                            การวิเคราะห์สเปกตรัมระบบประสาทอัตโนมัติ: แถบสีฟ้าคือคลื่นความถี่ต่ำ (LF: 0.04–0.15 Hz สะท้อนประสาทกระตุ้น Sympathetic); แถบสีเขียวคือคลื่นความถี่สูง (HF: 0.15–0.40 Hz สะท้อนประสาทผ่อนคลาย Parasympathetic) อัตราส่วน LF/HF ประมาณ 1.42 แสดงถึงความสมดุลที่ดี
                        </p>
                    </div>
                </div>

                <!-- Morphology Distributions by Diagnostic Superclass -->
                <div class="card card-custom mb-4" id="sec-morph-box">
                    <div class="card-header-custom">
                        <span><i class="fas fa-cubes me-2 text-warning"></i> การกระจายตัวของความกว้าง QRS จำแนกตาม 5 กลุ่มโรค (Morphology Boxplot Distribution)</span>
                        <span class="badge-neon-purple">เปรียบเทียบ NORM vs CD vs MI</span>
                    </div>
                    <div class="card-body-custom">
                        <div id="chart-morphology-box" style="height: 320px;"></div>
                        <p class="small text-muted mt-2 mb-0">
                            การยืนยันทางสรีรวิทยาไฟฟ้า: กลุ่มโรคการนำไฟฟ้าขัดข้อง (CD) มีความกว้างคลื่น QRS สูงกว่า 115 ms อย่างชัดเจน ขณะที่กลุ่มปกติ (NORM) มีความกว้างคลื่นอยู่ในช่วง 80–95 ms
                        </p>
                    </div>
                </div>

                <!-- Heavy EDA: Pearson Correlation Heatmap & Outlier Inventory -->
                <div class="row g-4 mb-4">
                    <div class="col-lg-6" id="sec-corr-heatmap">
                        <div class="card card-custom h-100">
                            <div class="card-header-custom">
                                <span><i class="fas fa-fire me-2 text-danger"></i> แผนภาพสหสัมพันธ์เพียร์สัน (Pearson Correlation Heatmap)</span>
                                <span class="badge-neon-coral">10 ฟีเจอร์ชีวการแพทย์หลัก</span>
                            </div>
                            <div class="card-body-custom">
                                <div id="chart-corr-heatmap" style="height: 340px;"></div>
                                <p class="small text-muted mt-2 mb-0">
                                    สหสัมพันธ์ระหว่างฟีเจอร์: RMSSD และ SDNN มีสหสัมพันธ์เชิงบวกสูง (r &gt; 0.75) สอดคล้องกับทฤษฎีสรีรวิทยาประสาท ขณะที่อัตราการเต้นหัวใจมีสหสัมพันธ์เชิงลบกับช่วง RR
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6" id="sec-eda-stats">
                        <div class="card card-custom h-100">
                            <div class="card-header-custom">
                                <span><i class="fas fa-chart-pie me-2 text-primary"></i> การตรวจสอบความเบ้ (Skewness) และค่าผิดปกติ (IQR Outliers)</span>
                                <span class="badge-neon-green">IQR Filter Method</span>
                            </div>
                            <div class="card-body-custom p-0" style="max-height: 340px; overflow-y: auto;">
                                <table class="table table-custom table-sm">
