e30\u0e01\u0e25\u0e49\u0e32\u0e21\u0e40\u0e19\u0e37\u0e49\u0e2d\u0e2b\u0e31\u0e27\u0e43\u0e08\u0e2b\u0e19\u0e32\u0e15\u0e31\u0e27\u0e1c\u0e34\u0e14\u0e1b\u0e01\u0e15\u0e34\u0e2b\u0e23\u0e37\u0e2d\u0e2b\u0e31\u0e27\u0e43\u0e08\u0e42\u0e15 (Ventricular Hypertrophy \u0e40\u0e0a\u0e48\u0e19 LVH) \u0e04\u0e27\u0e32\u0e21\u0e40\u0e0a\u0e37\u0e48\u0e2d\u0e21\u0e31\u0e48\u0e19 83.6% \u0e14\u0e31\u0e0a\u0e19\u0e35 Sokolow-Lyon \u0e2a\u0e39\u0e07\u0e16\u0e36\u0e07 4.23 mV", "morphology_evaluation": "\u0e41\u0e23\u0e07\u0e14\u0e31\u0e19\u0e44\u0e1f\u0e1f\u0e49\u0e32\u0e04\u0e25\u0e37\u0e48\u0e19\u0e2b\u0e31\u0e27\u0e43\u0e08\u0e2a\u0e39\u0e07\u0e40\u0e14\u0e48\u0e19\u0e02\u0e49\u0e32\u0e21\u0e40\u0e01\u0e13\u0e11\u0e4c\u0e27\u0e34\u0e19\u0e34\u0e08\u0e09\u0e31\u0e22 (Sokolow-Lyon Index S_V1 + R_V5 = 4.23 mV, \u0e40\u0e01\u0e13\u0e11\u0e4c\u0e27\u0e34\u0e19\u0e34\u0e08\u0e09\u0e31\u0e22 LVH > 3.5 mV) \u0e23\u0e48\u0e27\u0e21\u0e01\u0e31\u0e1a\u0e23\u0e30\u0e22\u0e30 QTc 202 ms \u0e1a\u0e48\u0e07\u0e0a\u0e35\u0e49\u0e01\u0e32\u0e23\u0e1b\u0e23\u0e31\u0e1a\u0e42\u0e04\u0e23\u0e07\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e02\u0e2d\u0e07\u0e01\u0e25\u0e49\u0e32\u0e21\u0e40\u0e19\u0e37\u0e49\u0e2d\u0e2b\u0e31\u0e27\u0e43\u0e08\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e23\u0e31\u0e1a\u0e41\u0e23\u0e07\u0e15\u0e49\u0e32\u0e19\u0e17\u0e32\u0e19\u0e04\u0e27\u0e32\u0e21\u0e14\u0e31\u0e19\u0e2a\u0e39\u0e07\u0e40\u0e23\u0e37\u0e49\u0e2d\u0e23\u0e31\u0e07", "autonomic_evaluation": "\u0e04\u0e27\u0e32\u0e21\u0e41\u0e1b\u0e23\u0e1b\u0e23\u0e27\u0e19 HRV \u0e1b\u0e32\u0e19\u0e01\u0e25\u0e32\u0e07 (SDNN 81.3 ms) \u0e2a\u0e30\u0e17\u0e49\u0e2d\u0e19\u0e04\u0e27\u0e32\u0e21\u0e15\u0e36\u0e07\u0e40\u0e04\u0e23\u0e35\u0e22\u0e14\u0e02\u0e2d\u0e07\u0e1c\u0e19\u0e31\u0e07\u0e01\u0e25\u0e49\u0e32\u0e21\u0e40\u0e19\u0e37\u0e49\u0e2d\u0e2b\u0e31\u0e27\u0e43\u0e08 (Myocardial Wall Stress)", "clinical_risk_level": "\u0e04\u0e27\u0e32\u0e21\u0e40\u0e2a\u0e35\u0e48\u0e22\u0e07\u0e1b\u0e32\u0e19\u0e01\u0e25\u0e32\u0e07 (Moderate Risk - Structural Remodeling) \ud83d\udfe1", "risk_badge_color": "warning", "recommendations": ["\u0e2a\u0e48\u0e07\u0e15\u0e23\u0e27\u0e08\u0e04\u0e25\u0e37\u0e48\u0e19\u0e40\u0e2a\u0e35\u0e22\u0e07\u0e2a\u0e30\u0e17\u0e49\u0e2d\u0e19\u0e2b\u0e31\u0e27\u0e43\u0e08 (Echocardiography) \u0e27\u0e31\u0e14\u0e04\u0e27\u0e32\u0e21\u0e2b\u0e19\u0e32\u0e02\u0e2d\u0e07\u0e1c\u0e19\u0e31\u0e07\u0e01\u0e25\u0e49\u0e32\u0e21\u0e40\u0e19\u0e37\u0e49\u0e2d\u0e2b\u0e31\u0e27\u0e43\u0e08\u0e2b\u0e49\u0e2d\u0e07\u0e25\u0e48\u0e32\u0e07\u0e0b\u0e49\u0e32\u0e22\u0e41\u0e25\u0e30\u0e21\u0e27\u0e25\u0e01\u0e25\u0e49\u0e32\u0e21\u0e40\u0e19\u0e37\u0e49\u0e2d\u0e2b\u0e31\u0e27\u0e43\u0e08 (LV Mass Index)", "\u0e04\u0e27\u0e1a\u0e04\u0e38\u0e21\u0e23\u0e30\u0e14\u0e31\u0e1a\u0e04\u0e27\u0e32\u0e21\u0e14\u0e31\u0e19\u0e42\u0e25\u0e2b\u0e34\u0e15\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e40\u0e02\u0e49\u0e21\u0e07\u0e27\u0e14\u0e14\u0e49\u0e27\u0e22\u0e22\u0e32\u0e01\u0e25\u0e38\u0e48\u0e21 ACEI/ARB \u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e0a\u0e30\u0e25\u0e2d\u0e41\u0e25\u0e30\u0e1f\u0e37\u0e49\u0e19\u0e1f\u0e39\u0e20\u0e32\u0e27\u0e30\u0e01\u0e25\u0e49\u0e32\u0e21\u0e40\u0e19\u0e37\u0e49\u0e2d\u0e2b\u0e31\u0e27\u0e43\u0e08\u0e2b\u0e19\u0e32\u0e15\u0e31\u0e27 (Reverse Remodeling)", "\u0e1b\u0e23\u0e30\u0e40\u0e21\u0e34\u0e19\u0e2b\u0e32\u0e20\u0e32\u0e27\u0e30\u0e41\u0e17\u0e23\u0e01\u0e0b\u0e49\u0e2d\u0e19 \u0e40\u0e0a\u0e48\u0e19 \u0e20\u0e32\u0e27\u0e30\u0e2b\u0e31\u0e27\u0e43\u0e08\u0e25\u0e49\u0e21\u0e40\u0e2b\u0e25\u0e27 (Heart Failure with Preserved Ejection Fraction - HFpEF)"], "cot_reasoning": ["1. \u0e01\u0e32\u0e23\u0e27\u0e34\u0e40\u0e04\u0e23\u0e32\u0e30\u0e2b\u0e4c\u0e08\u0e31\u0e07\u0e2b\u0e27\u0e30\u0e41\u0e25\u0e30\u0e2d\u0e31\u0e15\u0e23\u0e32: \u0e2d\u0e31\u0e15\u0e23\u0e32\u0e40\u0e15\u0e49\u0e19\u0e40\u0e09\u0e25\u0e35\u0e48\u0e22 92 bpm \u0e2d\u0e22\u0e39\u0e48\u0e43\u0e19\u0e40\u0e01\u0e13\u0e11\u0e4c \u0e1b\u0e01\u0e15\u0e34 (60-100 bpm)", "2. \u0e01\u0e32\u0e23\u0e15\u0e23\u0e