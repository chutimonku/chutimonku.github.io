ด่นข้ามเกณฑ์วินิจฉัย (Sokolow-Lyon Index S_V1 + R_V5 = 4.11 mV, เกณฑ์วินิจฉัย LVH > 3.5 mV) ร่วมกับระยะ QTc 189 ms บ่งชี้การปรับโครงสร้างของกล้ามเนื้อหัวใจเพื่อรับแรงต้านทานความดันสูงเรื้อรัง", "autonomic_evaluation": "ความแปรปรวน HRV ปานกลาง (SDNN 195.9 ms) สะท้อนความตึงเครียดของผนังกล้ามเนื้อหัวใจ (Myocardial Wall Stress)", "clinical_risk_level": "ความเสี่ยงปานกลาง (Moderate Risk - Structural Remodeling) 🟡", "risk_badge_color": "warning", "recommendations": ["ส่งตรวจคลื่นเสียงสะท้อนหัวใจ (Echocardiography) วัดความหนาของผนังกล้ามเนื้อหัวใจห้องล่างซ้ายและมวลกล้ามเนื้อหัวใจ (LV Mass Index)", "ควบคุมระดับความดันโลหิตอย่างเข้มงวดด้วยยากลุ่ม ACEI/ARB เพื่อชะลอและฟื้นฟูภาวะกล้ามเนื้อหัวใจหนาตัว (Reverse Remodeling)", "ประเมินหาภาวะแทรกซ้อน เช่น ภาวะหัวใจล้มเหลว (Heart Failure with Preserved Ejection Fraction - HFpEF)"], "cot_reasoning": ["1. การวิเคราะห์จังหวะและอัตรา: อัตราเต้นเฉลี่ย 78 bpm อยู่ในเกณฑ์ ปกติ (60-100 bpm)", "2. การตรวจวัดช่วงเวลา: PR Interval ปกติ, QRS Duration = 93 ms (อยู่ในเกณฑ์ปกติ), QTc = 189 ms", "3. การตรวจสัณฐานการขาดเลือด: ST Elevation = +0.203 mV (ยกตัวเด่นชัดเสี่ยงต่อ STEMI)", "4. การวิเคราะห์แรงดันโครงสร้าง: Sokolow-Lyon = 4.11 mV (เข้าเกณฑ์หัวใจโต LVH >3.5 mV)", "5. การบูรณาการโมเดล: โมเดล LightGBM และ ResNet1D ให้ผลพยากรณ์ชั้นโรคสูงสุดที่ 'HYP' ด้วยความน่าจะเป็น 83.5% สอดคล้องกับพยาธิสภาพทางคลินิก"]}, "cnn_predictions": {"stage1_binary": {"is_abnormal": true, "status_thai": "ผิดปกติ (Cardiac Pathology Detected)", "prob_abnormal": 99.8, "prob_normal": 0.2}, "stage2_multiclass": {"predicted_class": "MI", "probabilities": {"CD": 0.1313, "HYP": 0.001, "MI": 0.7415, "NORM": 0.004, "STTC": 0.1221}}}, "cnn_1d_cam_weights": [0.041099999099969864, 0.041099999099969864, 0.041099999099969864, 0.041099999099969864, 0.061000000685453415, 0.08460000157356262, 0.10809999704360962, 0.13169999420642853, 0.15520000457763672, 0.17870000004768372, 0.19509999454021454, 0.20229999721050262, 0.2093999981880188, 0.21649999916553497, 0.22360000014305115, 0.230700001