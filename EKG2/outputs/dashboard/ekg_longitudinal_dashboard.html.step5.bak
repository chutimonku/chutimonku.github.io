ตรวจพบความผิดปกติของช่วง ST-Segment และคลื่น T (ST/T Morphological Changes) ความเชื่อมั่น 57.9% สะท้อนภาวะเลือดไปเลี้ยงกล้ามเนื้อหัวใจบกพร่องหรือความผิดปกติในการคลายตัว (Myocardial Ischemia / Strain Pattern)", "morphology_evaluation": "การเปลี่ยนแปลงของคลื่น ST-T (ST Depression หรือ T-wave Inversion) โดยความกว้างคลื่น QRS อยู่ที่ 71 ms และระยะ QTc อยู่ที่ 330 ms สะท้อนการคลายตัวของเซลล์กล้ามเนื้อหัวใจห้องล่างผิดปกติ", "autonomic_evaluation": "อัตราเต้นหัวใจ 73 bpm, RMSSD 35.7 ms ควรตรวจแยกโรคระหว่างกล้ามเนื้อหัวใจขาดเลือดเรื้อรัง (Chronic Ischemia) กับความไม่สมดุลของเกลือแร่ในเลือด", "clinical_risk_level": "ความเสี่ยงปานกลาง (Moderate Risk - Ischemia Surveillance) 🟡", "risk_badge_color": "warning", "recommendations": ["ตรวจเลือดดูระดับเกลือแร่ในร่างกาย (Serum Electrolytes: K+, Mg2+, Ca2+) เพื่อแยกภาวะเกลือแร่ผิดปกติ", "พิจารณาส่งตรวจสมรรถภาพหัวใจขณะออกกำลังกาย (Exercise Stress Test) หรือ Coronary CT Angiography ตามอาการทางคลินิก", "ให้ยาควบคุมอัตราการเต้นหัวใจและยาลดการทำงานของกล้ามเนื้อหัวใจตามข้อบ่งชี้ทางอายุรศาสตร์"], "cot_reasoning": ["1. การวิเคราะห์จังหวะและอัตรา: อัตราเต้นเฉลี่ย 73 bpm อยู่ในเกณฑ์ ปกติ (60-100 bpm)", "2. การตรวจวัดช่วงเวลา: PR Interval ปกติ, QRS Duration = 71 ms (อยู่ในเกณฑ์ปกติ), QTc = 330 ms", "3. การตรวจสัณฐานการขาดเลือด: ST Elevation = +0.079 mV (ไม่พบ ST elevation วิกฤต)", "4. การวิเคราะห์แรงดันโครงสร้าง: Sokolow-Lyon = 1.43 mV (ปกติ)", "5. การบูรณาการโมเดล: โมเดล LightGBM และ ResNet1D ให้ผลพยากรณ์ชั้นโรคสูงสุดที่ 'STTC' ด้วยความน่าจะเป็น 57.9% สอดคล้องกับพยาธิสภาพทางคลินิก"]}, "cnn_predictions": {"stage1_binary": {"is_abnormal": true, "status_thai": "ผิดปกติ (Cardiac Pathology Detected)", "prob_abnormal": 99.6, "prob_normal": 0.4}, "stage2_multiclass": {"predicted_class": "STTC", "probabilities": {"CD": 0.024, "HYP": 0.0014, "MI": 0.4085, "NORM": 0.0094, "STTC": 0.5568}}}, "cnn_1d_cam_weights": [0.0, 0.0, 0.0, 0.0, 0.031599998474121094, 0.0689999982714653, 0.10639999806880951, 0.14380000531673431, 0.18129999935626984, 0.2187000066041946