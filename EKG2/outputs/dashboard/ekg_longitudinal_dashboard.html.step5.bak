เคราะห์แรงดันโครงสร้าง: Sokolow-Lyon = 1.74 mV (ปกติ)", "5. การบูรณาการโมเดล: โมเดล LightGBM และ ResNet1D ให้ผลพยากรณ์ชั้นโรคสูงสุดที่ 'MI' ด้วยความน่าจะเป็น 79.1% สอดคล้องกับพยาธิสภาพทางคลินิก"]}, "cnn_predictions": {"stage1_binary": {"is_abnormal": true, "status_thai": "ผิดปกติ (Cardiac Pathology Detected)", "prob_abnormal": 99.6, "prob_normal": 0.4}, "stage2_multiclass": {"predicted_class": "MI", "probabilities": {"CD": 0.0099, "HYP": 0.0, "MI": 0.9853, "NORM": 0.0036, "STTC": 0.0012}}}, "cnn_1d_cam_weights": [0.0, 0.0, 0.0, 0.0, 0.015399999916553497, 0.03370000049471855, 0.052000001072883606, 0.07020000368356705, 0.0885000005364418, 0.10670000314712524, 0.12630000710487366, 0.147599995136261, 0.1687999963760376, 0.19009999930858612, 0.21130000054836273, 0.23260000348091125, 0.25369998812675476, 0.27059999108314514, 0.2874999940395355, 0.3043999969959259, 0.32120001316070557, 0.33809998631477356, 0.35499998927116394, 0.3569999933242798, 0.3495999872684479, 0.34220001101493835, 0.33480000495910645, 0.32749998569488525, 0.32010000944137573, 0.3156999945640564, 0.32280001044273376, 0.32989999651908875, 0.3370000123977661, 0.3440999984741211, 0.35120001435279846, 0.35830000042915344, 0.36899998784065247, 0.3804999887943268, 0.3921000063419342, 0.40369999408721924, 0.41530001163482666, 0.4268999993801117, 0.44679999351501465, 0.4799000024795532, 0.5131000280380249, 0.5461999773979187, 0.5794000029563904, 0.6126000285148621, 0.6456999778747559, 0.6430000066757202, 0.63919997215271, 0.6355000138282776, 0.6316999793052673, 0.628000020980835, 0.6243000030517578, 0.6141999959945679, 0.5993000268936157, 0.5843999981880188, 0.5694000124931335, 0.5544999837875366, 0.5396000146865845, 0.5289999842643738, 0.5428000092506409, 0.5566999912261963, 0.5705000162124634, 0.5842999815940857, 0.5981000065803528, 0.6118999719619751, 0.6389999985694885, 0.670799970626831, 0.7024999856948853, 0.7342000007629395, 0.765999972820282, 0.7976999878883362, 0.8094000220298767, 0.7807000279426575,