D ให้ผลพยากรณ์ชั้นโรคสูงสุดที่ 'CD' ด้วยความน่าจะเป็น 47.9% สอดคล้องกับพยาธิสภาพทางคลินิก"]}, "cnn_predictions": {"stage1_binary": {"is_abnormal": true, "status_thai": "ผิดปกติ (Cardiac Pathology Detected)", "prob_abnormal": 98.4, "prob_normal": 1.6}, "stage2_multiclass": {"predicted_class": "MI", "probabilities": {"CD": 0.0157, "HYP": 0.0002, "MI": 0.9662, "NORM": 0.0155, "STTC": 0.0024}}}, "cnn_1d_cam_weights": [0.31139999628067017, 0.31139999628067017, 0.31139999628067017, 0.31139999628067017, 0.3199999928474426, 0.3301999866962433, 0.34040001034736633, 0.3504999876022339, 0.36070001125335693, 0.3709000051021576, 0.37369999289512634, 0.3668000102043152, 0.36000001430511475, 0.3531000018119812, 0.34619998931884766, 0.3393999934196472, 0.33320000767707825, 0.35260000824928284, 0.37209999561309814, 0.39149999618530273, 0.41100001335144043, 0.430400013923645, 0.4498000144958496, 0.4708000123500824, 0.4925999939441681, 0.5145000219345093, 0.536300003528595, 0.5580999851226807, 0.5799999833106995, 0.593500018119812, 0.5745000243186951, 0.5554999709129333, 0.5364999771118164, 0.5174999833106995, 0.4984999895095825, 0.4794999957084656, 0.44850000739097595, 0.41449999809265137, 0.3804999887943268, 0.3463999927043915, 0.3124000132083893, 0.2782999873161316, 0.2750999927520752, 0.321399986743927, 0.3677000105381012, 0.414000004529953, 0.4602999985218048, 0.506600022315979, 0.5527999997138977, 0.49970000982284546, 0.4438999891281128, 0.3880000114440918, 0.3321000039577484, 0.27630001306533813, 0.22040000557899475, 0.20029999315738678, 0.20800000429153442, 0.21570000052452087, 0.22339999675750732, 0.23109999299049377, 0.23880000412464142, 0.2515999972820282, 0.29260000586509705, 0.3334999978542328, 0.37439998984336853, 0.41530001163482666, 0.4562999904155731, 0.49720001220703125, 0.5117999911308289, 0.517300009727478, 0.5227000117301941, 0.5281999707221985, 0.5336999893188477, 0.5390999913215637, 0.536899983882904, 0.5189999938011169, 0.5012000203132629, 0.48330000042915344, 