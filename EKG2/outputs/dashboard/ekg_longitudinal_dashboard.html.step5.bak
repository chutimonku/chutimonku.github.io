htGBM และ ResNet1D ให้ผลพยากรณ์ชั้นโรคสูงสุดที่ 'HYP' ด้วยความน่าจะเป็น 83.0% สอดคล้องกับพยาธิสภาพทางคลินิก"]}, "cnn_predictions": {"stage1_binary": {"is_abnormal": true, "status_thai": "ผิดปกติ (Cardiac Pathology Detected)", "prob_abnormal": 99.0, "prob_normal": 1.0}, "stage2_multiclass": {"predicted_class": "MI", "probabilities": {"CD": 0.1942, "HYP": 0.0054, "MI": 0.4856, "NORM": 0.014, "STTC": 0.3008}}}, "cnn_1d_cam_weights": [0.784500002861023, 0.784500002861023, 0.784500002861023, 0.784500002861023, 0.7843999862670898, 0.7843999862670898, 0.7843000292778015, 0.7842000126838684, 0.7842000126838684, 0.7840999960899353, 0.7620000243186951, 0.7110999822616577, 0.660099983215332, 0.6092000007629395, 0.5583000183105469, 0.5073999762535095, 0.4575999975204468, 0.4526999890804291, 0.44780001044273376, 0.44290000200271606, 0.43799999356269836, 0.43299999833106995, 0.42809998989105225, 0.4749999940395355, 0.5544999837875366, 0.6340000033378601, 0.7135000228881836, 0.792900025844574, 0.8723999857902527, 0.9210000038146973, 0.8485999703407288, 0.776199996471405, 0.7038000226020813, 0.6313999891281128, 0.5590000152587891, 0.48669999837875366, 0.4867999851703644, 0.5058000087738037, 0.5248000025749207, 0.5437999963760376, 0.5627999901771545, 0.5817999839782715, 0.5849999785423279, 0.5629000067710876, 0.5407999753952026, 0.5187000036239624, 0.4966000020503998, 0.47440001368522644, 0.4523000121116638, 0.47200000286102295, 0.4927999973297119, 0.5135999917984009, 0.5343999862670898, 0.5551999807357788, 0.5759999752044678, 0.6154999732971191, 0.669700026512146, 0.723800003528595, 0.777899980545044, 0.8320000171661377, 0.8862000107765198, 0.9222000241279602, 0.8575999736785889, 0.7930999994277954, 0.728600025177002, 0.6639999747276306, 0.5995000004768372, 0.5349000096321106, 0.5072000026702881, 0.49219998717308044, 0.4772999882698059, 0.46230000257492065, 0.447299987077713, 0.4323999881744385, 0.45239999890327454, 0.542900025844574, 0.633400022983551, 0.723800003528595, 0.8143000