กโรคระหว่างกล้ามเนื้อหัวใจขาดเลือดเรื้อรัง (Chronic Ischemia) กับความไม่สมดุลของเกลือแร่ในเลือด", "clinical_risk_level": "ความเสี่ยงปานกลาง (Moderate Risk - Ischemia Surveillance) 🟡", "risk_badge_color": "warning", "recommendations": ["ตรวจเลือดดูระดับเกลือแร่ในร่างกาย (Serum Electrolytes: K+, Mg2+, Ca2+) เพื่อแยกภาวะเกลือแร่ผิดปกติ", "พิจารณาส่งตรวจสมรรถภาพหัวใจขณะออกกำลังกาย (Exercise Stress Test) หรือ Coronary CT Angiography ตามอาการทางคลินิก", "ให้ยาควบคุมอัตราการเต้นหัวใจและยาลดการทำงานของกล้ามเนื้อหัวใจตามข้อบ่งชี้ทางอายุรศาสตร์"], "cot_reasoning": ["1. การวิเคราะห์จังหวะและอัตรา: อัตราเต้นเฉลี่ย 62 bpm อยู่ในเกณฑ์ ปกติ (60-100 bpm)", "2. การตรวจวัดช่วงเวลา: PR Interval ปกติ, QRS Duration = 68 ms (อยู่ในเกณฑ์ปกติ), QTc = 333 ms", "3. การตรวจสัณฐานการขาดเลือด: ST Elevation = +0.071 mV (ไม่พบ ST elevation วิกฤต)", "4. การวิเคราะห์แรงดันโครงสร้าง: Sokolow-Lyon = 2.60 mV (ปกติ)", "5. การบูรณาการโมเดล: โมเดล LightGBM และ ResNet1D ให้ผลพยากรณ์ชั้นโรคสูงสุดที่ 'STTC' ด้วยความน่าจะเป็น 76.6% สอดคล้องกับพยาธิสภาพทางคลินิก"]}, "cnn_predictions": {"stage1_binary": {"is_abnormal": true, "status_thai": "ผิดปกติ (Cardiac Pathology Detected)", "prob_abnormal": 98.8, "prob_normal": 1.2}, "stage2_multiclass": {"predicted_class": "MI", "probabilities": {"CD": 0.237, "HYP": 0.0063, "MI": 0.5293, "NORM": 0.0148, "STTC": 0.2125}}}, "cnn_1d_cam_weights": [0.10679999738931656, 0.10679999738931656, 0.10679999738931656, 0.10679999738931656, 0.13199999928474426, 0.16179999709129333, 0.1915999948978424, 0.22139999270439148, 0.25119999051094055, 0.2809999883174896, 0.29789999127388, 0.2978000044822693, 0.2976999878883362, 0.29760000109672546, 0.29750001430511475, 0.29750001430511475, 0.2969000041484833, 0.2777000069618225, 0.25850000977516174, 0.23929999768733978, 0.22010000050067902, 0.20090000331401825, 0.18170000612735748, 0.19419999420642853, 0.22669999301433563, 0.2590999901294708, 0.2915000021457672, 0.3239000141620636, 0.3564000129699707, 0.3846000134944916, 0.3962000012397766, 0.