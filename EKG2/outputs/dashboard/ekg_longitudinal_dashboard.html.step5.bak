clinical_risk_level": "ความเสี่ยงปานกลาง (Moderate Risk - Ischemia Surveillance) 🟡", "risk_badge_color": "warning", "recommendations": ["ตรวจเลือดดูระดับเกลือแร่ในร่างกาย (Serum Electrolytes: K+, Mg2+, Ca2+) เพื่อแยกภาวะเกลือแร่ผิดปกติ", "พิจารณาส่งตรวจสมรรถภาพหัวใจขณะออกกำลังกาย (Exercise Stress Test) หรือ Coronary CT Angiography ตามอาการทางคลินิก", "ให้ยาควบคุมอัตราการเต้นหัวใจและยาลดการทำงานของกล้ามเนื้อหัวใจตามข้อบ่งชี้ทางอายุรศาสตร์"], "cot_reasoning": ["1. การวิเคราะห์จังหวะและอัตรา: อัตราเต้นเฉลี่ย 65 bpm อยู่ในเกณฑ์ ปกติ (60-100 bpm)", "2. การตรวจวัดช่วงเวลา: PR Interval ปกติ, QRS Duration = 78 ms (อยู่ในเกณฑ์ปกติ), QTc = 310 ms", "3. การตรวจสัณฐานการขาดเลือด: ST Elevation = +0.119 mV (ยกตัวเด่นชัดเสี่ยงต่อ STEMI)", "4. การวิเคราะห์แรงดันโครงสร้าง: Sokolow-Lyon = 2.52 mV (ปกติ)", "5. การบูรณาการโมเดล: โมเดล LightGBM และ ResNet1D ให้ผลพยากรณ์ชั้นโรคสูงสุดที่ 'STTC' ด้วยความน่าจะเป็น 47.6% สอดคล้องกับพยาธิสภาพทางคลินิก"]}, "cnn_predictions": {"stage1_binary": {"is_abnormal": true, "status_thai": "ผิดปกติ (Cardiac Pathology Detected)", "prob_abnormal": 59.0, "prob_normal": 41.0}, "stage2_multiclass": {"predicted_class": "NORM", "probabilities": {"CD": 0.1825, "HYP": 0.0889, "MI": 0.0787, "NORM": 0.465, "STTC": 0.185}}}, "cnn_1d_cam_weights": [0.439300000667572, 0.439300000667572, 0.439300000667572, 0.439300000667572, 0.44269999861717224, 0.44670000672340393, 0.4507000148296356, 0.4546999931335449, 0.4587000012397766, 0.4627000093460083, 0.5013999938964844, 0.5852000117301941, 0.6690999865531921, 0.753000020980835, 0.8367999792098999, 0.9207000136375427, 1.0, 0.8970000147819519, 0.7939000129699707, 0.6909000277519226, 0.5878000259399414, 0.4848000109195709, 0.38179999589920044, 0.3499999940395355, 0.3630000054836273, 0.37610000371932983, 0.38909998536109924, 0.40209999680519104, 0.41519999504089355, 0.4163999855518341, 0.37119999527931213, 0.3260999917984009, 0.2809999883174896, 0.23589999973773956, 0.1907999962568283, 0.14569999277591705, 0.13459999859333038, 0