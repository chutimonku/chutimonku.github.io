                <!-- Predicted Probabilities Bar Chart & Biomarkers Grid -->
                <div class="row g-4 mb-4">
                    <div class="col-lg-6">
                        <div class="card card-custom h-100">
                            <div class="card-header-custom">
                                <span><i class="fas fa-chart-simple me-2 text-info"></i> ความน่าจะเป็นจำแนก 5 กลุ่มโรค (Predicted Probabilities %)</span>
                                <span class="badge-neon-blue">Softmax Distribution</span>
                            </div>
                            <div class="card-body-custom">
                                <div id="chart-prediction-bars" style="height: 250px;"></div>
                                <div class="small text-muted mt-2 text-center font-code">
                                    NORM (ปกติ) | MI (กล้ามเนื้อขาดเลือด) | STTC (ST/T เปลี่ยน) | CD (นำไฟฟ้าขัดข้อง) | HYP (หัวใจโต)
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="card card-custom h-100">
                            <div class="card-header-custom">
                                <span><i class="fas fa-table-cells me-2 text-primary"></i> ค่าตัวชี้วัดสรีรวิทยาคลินิกประจำรอบการตรวจ (Biomarkers Grid)</span>
                                <span class="badge-neon-green">สกัดจากสัญญาณ 12 ลีด</span>
                            </div>
                            <div class="card-body-custom">
                                <div class="row g-2 text-center" id="grid-encounter-biomarkers">
                                    <!-- Dynamic JS -->
                                </div>
                            </div>
                        </div>
                    </div>
