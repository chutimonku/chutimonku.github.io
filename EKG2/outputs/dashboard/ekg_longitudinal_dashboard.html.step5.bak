เต้นเฉลี่ย 56 bpm สม่ำเสมอ ไม่พบการยกตัวหรือทรุดตัวของช่วง ST ที่ผิดปกติ", "morphology_evaluation": "กลุ่มคลื่น QRS มีความกว้างปกติ (57 ms, เกณฑ์ปกติ 80–110 ms) จังหวะการนำไฟฟ้าผ่าน AV Node และ Bundle Branches สมบูรณ์ดี ระยะ QTc เท่ากับ 306 ms ไม่พบภาวะเสี่ยงต่อ Long-QT", "autonomic_evaluation": "ดัชนีความแปรปรวนของการเต้นหัวใจ (SDNN = 73.5 ms, RMSSD = 116.9 ms) สะท้อนการทำงานของระบบประสาทเวกัสและระบบประสาทอัตโนมัติที่อยู่ในเกณฑ์สมดุลดี", "clinical_risk_level": "ความเสี่ยงต่ำ (Low Risk - Disease Free) 🟢", "risk_badge_color": "success", "recommendations": ["แนะนำตรวจติดตามสุขภาพหัวใจประจำปีตามวงรอบปกติ", "รักษาระดับการออกกำลังกายแบบแอโรบิกสม่ำเสมออย่างน้อย 150 นาที/สัปดาห์", "ควบคุมพฤติกรรมสุขภาพ หลีกเลี่ยงอาหารไขมันทรานส์ และตรวจคัดกรองความดันโลหิตเป็นระยะ"], "cot_reasoning": ["1. การวิเคราะห์จังหวะและอัตรา: อัตราเต้นเฉลี่ย 56 bpm อยู่ในเกณฑ์ เต้นช้าผิดปกติ (<60 bpm)", "2. การตรวจวัดช่วงเวลา: PR Interval ปกติ, QRS Duration = 57 ms (อยู่ในเกณฑ์ปกติ), QTc = 306 ms", "3. การตรวจสัณฐานการขาดเลือด: ST Elevation = +0.136 mV (ยกตัวเด่นชัดเสี่ยงต่อ STEMI)", "4. การวิเคราะห์แรงดันโครงสร้าง: Sokolow-Lyon = 3.40 mV (ปกติ)", "5. การบูรณาการโมเดล: โมเดล LightGBM และ ResNet1D ให้ผลพยากรณ์ชั้นโรคสูงสุดที่ 'NORM' ด้วยความน่าจะเป็น 80.2% สอดคล้องกับพยาธิสภาพทางคลินิก"]}, "cnn_predictions": {"stage1_binary": {"is_abnormal": false, "status_thai": "ปกติ (Normal Sinus)", "prob_abnormal": 2.9, "prob_normal": 97.1}, "stage2_multiclass": {"predicted_class": "NORM", "probabilities": {"CD": 0.008, "HYP": 0.0129, "MI": 0.0056, "NORM": 0.9714, "STTC": 0.0021}}}, "cnn_1d_cam_weights": [0.11630000174045563, 0.11630000174045563, 0.11630000174045563, 0.11630000174045563, 0.14350000023841858, 0.17560000717639923, 0.2078000009059906, 0.23989999294281006, 0.2721000015735626, 0.3041999936103821, 0.3310000002384186, 0.3506999909877777, 0.3702999949455261, 0.38999998569488525, 0.4097000062465668, 0.4293999969959259, 0.4481000006198883, 0.4271000027656555, 0.40610000491142273, 0.38519999384880066, 0.3641