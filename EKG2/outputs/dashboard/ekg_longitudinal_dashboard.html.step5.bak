ดของกล้ามเนื้อหัวใจแบบ Transmural Ischemia สัมพันธ์กับภาวะหลอดเลือดหัวใจโคโรนารีอุดตันเฉียบพลัน คลื่น QRS กว้าง 71 ms", "autonomic_evaluation": "ความแปรปรวนของหัวใจลดต่ำลงผิดปกติ (SDNN = 4.8 ms, RMSSD = 6.4 ms) สอดคล้องกับภาวะกระตุ้นของระบบประสาทซิมพาเทติกอย่างรุนแรงจากความเครียดของกล้ามเนื้อหัวใจเฉียบพลัน", "clinical_risk_level": "วิกฤตฉุกเฉิน (High Critical Risk - Immediate Intervention) 🔴", "risk_badge_color": "danger", "recommendations": ["ส่งตัวเข้าห้องสวนหัวใจและหลอดเลือด (Cardiac Catheterization Lab) ด่วนที่สุดเพื่อพิจารณาทำ Primary PCI ภายใน 90 นาที", "เจาะเลือดตรวจชีวมาร์กเกอร์กล้ามเนื้อหัวใจ High-Sensitivity Troponin-T (hs-cTnT) และ CK-MB ทันที", "ให้การรักษาเบื้องต้นตามแนวทาง ACS: แอสไพรินเคี้ยวกลืน, ยาต้านเกล็ดเลือดตัวที่สอง (P2Y12 Inhibitor) และสารกันการแข็งตัวของเลือดภายใต้การควบคุมของอายุรแพทย์โรคหัวใจ"], "cot_reasoning": ["1. การวิเคราะห์จังหวะและอัตรา: อัตราเต้นเฉลี่ย 113 bpm อยู่ในเกณฑ์ เต้นเร็วผิดปกติ (>100 bpm)", "2. การตรวจวัดช่วงเวลา: PR Interval ปกติ, QRS Duration = 71 ms (อยู่ในเกณฑ์ปกติ), QTc = 350 ms", "3. การตรวจสัณฐานการขาดเลือด: ST Elevation = +0.099 mV (ไม่พบ ST elevation วิกฤต)", "4. การวิเคราะห์แรงดันโครงสร้าง: Sokolow-Lyon = 1.00 mV (ปกติ)", "5. การบูรณาการโมเดล: โมเดล LightGBM และ ResNet1D ให้ผลพยากรณ์ชั้นโรคสูงสุดที่ 'MI' ด้วยความน่าจะเป็น 37.4% สอดคล้องกับพยาธิสภาพทางคลินิก"]}, "cnn_predictions": {"stage1_binary": {"is_abnormal": true, "status_thai": "ผิดปกติ (Cardiac Pathology Detected)", "prob_abnormal": 97.7, "prob_normal": 2.3}, "stage2_multiclass": {"predicted_class": "MI", "probabilities": {"CD": 0.0179, "HYP": 0.0003, "MI": 0.9559, "NORM": 0.0224, "STTC": 0.0034}}}, "cnn_1d_cam_weights": [0.26930001378059387, 0.26930001378059387, 0.26930001378059387, 0.26930001378059387, 0.2653000056743622, 0.2606000006198883, 0.25589999556541443, 0.25110000371932983, 0.24639999866485596, 0.24169999361038208, 0.25220000743865967, 0.2824999988079071, 0.31290000677108765, 0.3431999981403351, 0.3736000061035156, 0.40389999747276306, 0.43270000