ง (Moderate Risk - Ischemia Surveillance) 🟡", "risk_badge_color": "warning", "recommendations": ["ตรวจเลือดดูระดับเกลือแร่ในร่างกาย (Serum Electrolytes: K+, Mg2+, Ca2+) เพื่อแยกภาวะเกลือแร่ผิดปกติ", "พิจารณาส่งตรวจสมรรถภาพหัวใจขณะออกกำลังกาย (Exercise Stress Test) หรือ Coronary CT Angiography ตามอาการทางคลินิก", "ให้ยาควบคุมอัตราการเต้นหัวใจและยาลดการทำงานของกล้ามเนื้อหัวใจตามข้อบ่งชี้ทางอายุรศาสตร์"], "cot_reasoning": ["1. การวิเคราะห์จังหวะและอัตรา: อัตราเต้นเฉลี่ย 74 bpm อยู่ในเกณฑ์ ปกติ (60-100 bpm)", "2. การตรวจวัดช่วงเวลา: PR Interval ปกติ, QRS Duration = 146 ms (กว้างผิดปกติ >110 ms), QTc = 225 ms", "3. การตรวจสัณฐานการขาดเลือด: ST Elevation = +0.049 mV (ไม่พบ ST elevation วิกฤต)", "4. การวิเคราะห์แรงดันโครงสร้าง: Sokolow-Lyon = 2.26 mV (ปกติ)", "5. การบูรณาการโมเดล: โมเดล LightGBM และ ResNet1D ให้ผลพยากรณ์ชั้นโรคสูงสุดที่ 'STTC' ด้วยความน่าจะเป็น 60.7% สอดคล้องกับพยาธิสภาพทางคลินิก"]}, "cnn_predictions": {"stage1_binary": {"is_abnormal": true, "status_thai": "ผิดปกติ (Cardiac Pathology Detected)", "prob_abnormal": 99.8, "prob_normal": 0.2}, "stage2_multiclass": {"predicted_class": "STTC", "probabilities": {"CD": 0.039, "HYP": 0.0008, "MI": 0.1268, "NORM": 0.0028, "STTC": 0.8306}}}, "cnn_1d_cam_weights": [0.04540000110864639, 0.04540000110864639, 0.04540000110864639, 0.04540000110864639, 0.08380000293254852, 0.12919999659061432, 0.17470000684261322, 0.22020000219345093, 0.2655999958515167, 0.3111000061035156, 0.33469998836517334, 0.33000001311302185, 0.32519999146461487, 0.3203999996185303, 0.3156000077724457, 0.3109000027179718, 0.30559998750686646, 0.27880001068115234, 0.25209999084472656, 0.22529999911785126, 0.19859999418258667, 0.17180000245571136, 0.14509999752044678, 0.13210000097751617, 0.12790000438690186, 0.12370000034570694, 0.11949999630451202, 0.1152999997138977, 0.11110000312328339, 0.11379999667406082, 0.14329999685287476, 0.1728000044822693, 0.20229999721050262, 0.23180000483989716, 0.2612999975681305, 0.290800005197525, 0.2662000060081482, 0.