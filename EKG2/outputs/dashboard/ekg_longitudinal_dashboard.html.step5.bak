onduction Blocks / Wide QRS)", "color": "#8b5cf6", "desc": "คลื่น QRS กว้างเด่น (>115ms), PR prolonged, เข้าข่าย LBBB/RBBB"}, "2": {"name": "คลัสเตอร์ 2: กล้ามเนื้อหัวใจขาดเลือดเฉียบพลัน (Acute Ischemia / STEMI)", "color": "#f43f5e", "desc": "ช่วง ST ยกตัวสูง (>0.15mV), T-wave inverted, มีความเสี่ยงวิกฤต"}, "3": {"name": "คลัสเตอร์ 3: กล้ามเนื้อหัวใจห้องล่างซ้ายหนาตัว (Left Ventricular Hypertrophy)", "color": "#14b8a6", "desc": "ดัชนี Sokolow-Lyon สูง (>3.5mV), แรงดันไฟฟ้าสูงผิดปกติ"}, "4": {"name": "คลัสเตอร์ 4: การคลายตัวแปรปรวน (Repolarization Changes / STTC)", "color": "#f59e0b", "desc": "ST depression หรือ T-wave แบนราบ, สะท้อนกล้ามเนื้อหัวใจตึงเครียด"}}}, "multi_model_leaderboard": {"LightGBM": {"model_name": "LightGBM (Gradient Boosting Trees)", "category": "Supervised Tabular ML", "rank": 1, "macro_roc_auc": 0.8854, "macro_f1": 0.6118, "macro_precision": 0.6284, "macro_recall": 0.6247, "balanced_acc": 0.6247, "overall_acc": 0.6762, "latency_ms": 0.007, "train_time_sec": 1.27, "per_class_recall": {"CD": 0.6361, "HYP": 0.5534, "MI": 0.4963, "NORM": 0.8123, "STTC": 0.6253}, "badge": "แชมเปี้ยนระบบคลินิก (Production Best)", "badge_color": "success", "status": "พร้อมใช้งานระดับคลินิก (Clinically Deployed)"}, "XGBoost": {"model_name": "XGBoost (Extreme Gradient Boosting)", "category": "Supervised Tabular ML", "rank": 2, "macro_roc_auc": 0.8921, "macro_f1": 0.603, "macro_precision": 0.6312, "macro_recall": 0.5874, "balanced_acc": 0.5874, "overall_acc": 0.6878, "latency_ms": 0.002, "train_time_sec": 1.18, "per_class_recall": {"CD": 0.5802, "HYP": 0.3953, "MI": 0.4826, "NORM": 0.9169, "STTC": 0.562}, "badge": "ความเร็วสูงพิเศษ (High Throughput)", "badge_color": "primary", "status": "พร้อมใช้งาน (Production Ready)"}, "ResNet1D": {"model_name": "ResNet1D (Deep Residual 1D-CNN)", "category": "Deep Learning (Raw Waveforms)", "rank": 3, "macro_roc_auc": 0.8912, "macro_f1": 0.6015, "macro_precision": 0.6195, "macro_recall": 0.5942, "balanced_acc": 0.5942, "overall_acc": 0.