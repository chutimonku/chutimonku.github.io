", "5. การบูรณาการโมเดล: โมเดล LightGBM และ ResNet1D ให้ผลพยากรณ์ชั้นโรคสูงสุดที่ 'MI' ด้วยความน่าจะเป็น 70.2% สอดคล้องกับพยาธิสภาพทางคลินิก"]}, "cnn_predictions": {"stage1_binary": {"is_abnormal": true, "status_thai": "ผิดปกติ (Cardiac Pathology Detected)", "prob_abnormal": 99.9, "prob_normal": 0.1}, "stage2_multiclass": {"predicted_class": "MI", "probabilities": {"CD": 0.0115, "HYP": 0.0001, "MI": 0.9672, "NORM": 0.0009, "STTC": 0.0204}}}, "cnn_1d_cam_weights": [0.0, 0.0, 0.0, 0.0, 0.039799999445676804, 0.0869000032544136, 0.1340000033378601, 0.181099995970726, 0.2282000035047531, 0.275299996137619, 0.3012999892234802, 0.3000999987125397, 0.298799991607666, 0.29750001430511475, 0.2962000072002411, 0.29499998688697815, 0.2944999933242798, 0.3260999917984009, 0.357699990272522, 0.38929998874664307, 0.42089998722076416, 0.45249998569488525, 0.48410001397132874, 0.49799999594688416, 0.5008000135421753, 0.5034999847412109, 0.5062999725341797, 0.5090000033378601, 0.5117999911308289, 0.5115000009536743, 0.49900001287460327, 0.48649999499320984, 0.4740999937057495, 0.46160000562667847, 0.44920000433921814, 0.4366999864578247, 0.4546000063419342, 0.4803999960422516, 0.5062000155448914, 0.5320000052452087, 0.5577999949455261, 0.5835999846458435, 0.5806999802589417, 0.5315999984741211, 0.48249998688697815, 0.4334000051021576, 0.38429999351501465, 0.335099995136261, 0.28600001335144043, 0.32269999384880066, 0.3617999851703644, 0.4009000062942505, 0.4399999976158142, 0.4790000021457672, 0.5181000232696533, 0.516700029373169, 0.4837999939918518, 0.45089998841285706, 0.4180000126361847, 0.38510000705718994, 0.3522000014781952, 0.3314000070095062, 0.37779998779296875, 0.4242999851703644, 0.4706999957561493, 0.5171999931335449, 0.5636000037193298, 0.6100999712944031, 0.5964000225067139, 0.5616999864578247, 0.5271000266075134, 0.4925000071525574, 0.4578000009059906, 0.42320001125335693, 0.40799999237060547, 0.4316999912261963, 0.4555000066757202, 0.47920000553131104, 0.502900004386