ใจลดต่ำลงผิดปกติ (SDNN = 55.2 ms, RMSSD = 50.9 ms) สอดคล้องกับภาวะกระตุ้นของระบบประสาทซิมพาเทติกอย่างรุนแรงจากความเครียดของกล้ามเนื้อหัวใจเฉียบพลัน", "clinical_risk_level": "วิกฤตฉุกเฉิน (High Critical Risk - Immediate Intervention) 🔴", "risk_badge_color": "danger", "recommendations": ["ส่งตัวเข้าห้องสวนหัวใจและหลอดเลือด (Cardiac Catheterization Lab) ด่วนที่สุดเพื่อพิจารณาทำ Primary PCI ภายใน 90 นาที", "เจาะเลือดตรวจชีวมาร์กเกอร์กล้ามเนื้อหัวใจ High-Sensitivity Troponin-T (hs-cTnT) และ CK-MB ทันที", "ให้การรักษาเบื้องต้นตามแนวทาง ACS: แอสไพรินเคี้ยวกลืน, ยาต้านเกล็ดเลือดตัวที่สอง (P2Y12 Inhibitor) และสารกันการแข็งตัวของเลือดภายใต้การควบคุมของอายุรแพทย์โรคหัวใจ"], "cot_reasoning": ["1. การวิเคราะห์จังหวะและอัตรา: อัตราเต้นเฉลี่ย 68 bpm อยู่ในเกณฑ์ ปกติ (60-100 bpm)", "2. การตรวจวัดช่วงเวลา: PR Interval ปกติ, QRS Duration = 20 ms (อยู่ในเกณฑ์ปกติ), QTc = 314 ms", "3. การตรวจสัณฐานการขาดเลือด: ST Elevation = +0.034 mV (ไม่พบ ST elevation วิกฤต)", "4. การวิเคราะห์แรงดันโครงสร้าง: Sokolow-Lyon = 1.70 mV (ปกติ)", "5. การบูรณาการโมเดล: โมเดล LightGBM และ ResNet1D ให้ผลพยากรณ์ชั้นโรคสูงสุดที่ 'MI' ด้วยความน่าจะเป็น 76.5% สอดคล้องกับพยาธิสภาพทางคลินิก"]}, "cnn_predictions": {"stage1_binary": {"is_abnormal": true, "status_thai": "ผิดปกติ (Cardiac Pathology Detected)", "prob_abnormal": 98.4, "prob_normal": 1.6}, "stage2_multiclass": {"predicted_class": "MI", "probabilities": {"CD": 0.0157, "HYP": 0.0002, "MI": 0.9654, "NORM": 0.0163, "STTC": 0.0024}}}, "cnn_1d_cam_weights": [0.0, 0.0, 0.0, 0.0, 0.04320000112056732, 0.094200000166893, 0.1453000009059906, 0.1964000016450882, 0.2475000023841858, 0.2985999882221222, 0.30959999561309814, 0.2685999870300293, 0.22759999334812164, 0.186599999666214, 0.14560000598430634, 0.10459999740123749, 0.06509999930858612, 0.08640000224113464, 0.10769999772310257, 0.1289999932050705, 0.15029999613761902, 0.17159999907016754, 0.19290000200271606, 0.2224999964237213, 0.2572999894618988, 0.2921999990940094, 0.3269999921321869, 0.3617999851703644, 0.