mmendations": ["ส่งตัวเข้าห้องสวนหัวใจและหลอดเลือด (Cardiac Catheterization Lab) ด่วนที่สุดเพื่อพิจารณาทำ Primary PCI ภายใน 90 นาที", "เจาะเลือดตรวจชีวมาร์กเกอร์กล้ามเนื้อหัวใจ High-Sensitivity Troponin-T (hs-cTnT) และ CK-MB ทันที", "ให้การรักษาเบื้องต้นตามแนวทาง ACS: แอสไพรินเคี้ยวกลืน, ยาต้านเกล็ดเลือดตัวที่สอง (P2Y12 Inhibitor) และสารกันการแข็งตัวของเลือดภายใต้การควบคุมของอายุรแพทย์โรคหัวใจ"], "cot_reasoning": ["1. การวิเคราะห์จังหวะและอัตรา: อัตราเต้นเฉลี่ย 77 bpm อยู่ในเกณฑ์ ปกติ (60-100 bpm)", "2. การตรวจวัดช่วงเวลา: PR Interval ปกติ, QRS Duration = 20 ms (อยู่ในเกณฑ์ปกติ), QTc = 275 ms", "3. การตรวจสัณฐานการขาดเลือด: ST Elevation = +0.081 mV (ไม่พบ ST elevation วิกฤต)", "4. การวิเคราะห์แรงดันโครงสร้าง: Sokolow-Lyon = 1.03 mV (ปกติ)", "5. การบูรณาการโมเดล: โมเดล LightGBM และ ResNet1D ให้ผลพยากรณ์ชั้นโรคสูงสุดที่ 'MI' ด้วยความน่าจะเป็น 90.0% สอดคล้องกับพยาธิสภาพทางคลินิก"]}, "cnn_predictions": {"stage1_binary": {"is_abnormal": true, "status_thai": "ผิดปกติ (Cardiac Pathology Detected)", "prob_abnormal": 97.8, "prob_normal": 2.2}, "stage2_multiclass": {"predicted_class": "MI", "probabilities": {"CD": 0.0099, "HYP": 0.0001, "MI": 0.9717, "NORM": 0.0173, "STTC": 0.0011}}}, "cnn_1d_cam_weights": [0.25999999046325684, 0.25999999046325684, 0.25999999046325684, 0.25999999046325684, 0.2531999945640564, 0.2451999932527542, 0.23720000684261322, 0.22920000553131104, 0.22120000422000885, 0.21320000290870667, 0.20999999344348907, 0.21310000121593475, 0.21619999408721924, 0.21930000185966492, 0.2224999964237213, 0.225600004196167, 0.22949999570846558, 0.26589998602867126, 0.30230000615119934, 0.33869999647140503, 0.3750999867916107, 0.4115000069141388, 0.44780001044273376, 0.4251999855041504, 0.36550000309944153, 0.30570000410079956, 0.2460000067949295, 0.18619999289512634, 0.1264999955892563, 0.08659999817609787, 0.12409999966621399, 0.1615999937057495, 0.19920000433921814, 0.23669999837875366, 0.2743000090122223, 0.3118000030517578, 0.3328999876976013, 0.349700003862381, 0