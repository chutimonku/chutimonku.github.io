                <!-- Detailed Clinical Metrics Table (8 Biomarkers with Ranges & Thai Interpretation) -->
                <div class="card card-custom mb-4" id="sec-detailed-metrics">
                    <div class="card-header-custom">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-heart-pulse me-2 text-primary"></i>
                            <span>ตารางค่าสรีรวิทยาคลินิกละเอียดและการแปลผลทางการแพทย์ (Detailed Clinical Metrics Table)</span>
                        </div>
                        <span class="badge-neon-teal">มาตรฐานการประเมินทางอายุรศาสตร์</span>
                    </div>
                    <div class="card-body-custom p-0">
                        <table class="table table-custom">
                            <thead>
                                <tr>
                                    <th>ตัวชี้วัดสรีรวิทยา (Biomarker)</th>
