ural Ischemia สัมพันธ์กับภาวะหลอดเลือดหัวใจโคโรนารีอุดตันเฉียบพลัน คลื่น QRS กว้าง 90 ms", "autonomic_evaluation": "ความแปรปรวนของหัวใจลดต่ำลงผิดปกติ (SDNN = 6.7 ms, RMSSD = 6.0 ms) สอดคล้องกับภาวะกระตุ้นของระบบประสาทซิมพาเทติกอย่างรุนแรงจากความเครียดของกล้ามเนื้อหัวใจเฉียบพลัน", "clinical_risk_level": "วิกฤตฉุกเฉิน (High Critical Risk - Immediate Intervention) 🔴", "risk_badge_color": "danger", "recommendations": ["ส่งตัวเข้าห้องสวนหัวใจและหลอดเลือด (Cardiac Catheterization Lab) ด่วนที่สุดเพื่อพิจารณาทำ Primary PCI ภายใน 90 นาที", "เจาะเลือดตรวจชีวมาร์กเกอร์กล้ามเนื้อหัวใจ High-Sensitivity Troponin-T (hs-cTnT) และ CK-MB ทันที", "ให้การรักษาเบื้องต้นตามแนวทาง ACS: แอสไพรินเคี้ยวกลืน, ยาต้านเกล็ดเลือดตัวที่สอง (P2Y12 Inhibitor) และสารกันการแข็งตัวของเลือดภายใต้การควบคุมของอายุรแพทย์โรคหัวใจ"], "cot_reasoning": ["1. การวิเคราะห์จังหวะและอัตรา: อัตราเต้นเฉลี่ย 76 bpm อยู่ในเกณฑ์ ปกติ (60-100 bpm)", "2. การตรวจวัดช่วงเวลา: PR Interval ปกติ, QRS Duration = 90 ms (อยู่ในเกณฑ์ปกติ), QTc = 308 ms", "3. การตรวจสัณฐานการขาดเลือด: ST Elevation = +0.212 mV (ยกตัวเด่นชัดเสี่ยงต่อ STEMI)", "4. การวิเคราะห์แรงดันโครงสร้าง: Sokolow-Lyon = 2.33 mV (ปกติ)", "5. การบูรณาการโมเดล: โมเดล LightGBM และ ResNet1D ให้ผลพยากรณ์ชั้นโรคสูงสุดที่ 'MI' ด้วยความน่าจะเป็น 79.8% สอดคล้องกับพยาธิสภาพทางคลินิก"]}, "cnn_predictions": {"stage1_binary": {"is_abnormal": true, "status_thai": "ผิดปกติ (Cardiac Pathology Detected)", "prob_abnormal": 99.9, "prob_normal": 0.1}, "stage2_multiclass": {"predicted_class": "MI", "probabilities": {"CD": 0.0186, "HYP": 0.0001, "MI": 0.971, "NORM": 0.0013, "STTC": 0.009}}}, "cnn_1d_cam_weights": [0.25060001015663147, 0.25060001015663147, 0.25060001015663147, 0.25060001015663147, 0.2542000114917755, 0.25850000977516174, 0.262800008058548, 0.2669999897480011, 0.27129998803138733, 0.27559998631477356, 0.29339998960494995, 0.328900009393692, 0.364300012588501, 0.39980000257492065, 0.4352000057697296, 0.4706000089645386, 0.507099986076355, 0.5842999815940857, 0.661499977111