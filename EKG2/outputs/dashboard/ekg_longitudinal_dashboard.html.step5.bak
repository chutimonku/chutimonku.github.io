ัตราเต้นเฉลี่ย 84 bpm อยู่ในเกณฑ์ ปกติ (60-100 bpm)", "2. การตรวจวัดช่วงเวลา: PR Interval ปกติ, QRS Duration = 72 ms (อยู่ในเกณฑ์ปกติ), QTc = 338 ms", "3. การตรวจสัณฐานการขาดเลือด: ST Elevation = +0.024 mV (ไม่พบ ST elevation วิกฤต)", "4. การวิเคราะห์แรงดันโครงสร้าง: Sokolow-Lyon = 2.44 mV (ปกติ)", "5. การบูรณาการโมเดล: โมเดล LightGBM และ ResNet1D ให้ผลพยากรณ์ชั้นโรคสูงสุดที่ 'STTC' ด้วยความน่าจะเป็น 75.2% สอดคล้องกับพยาธิสภาพทางคลินิก"]}, "cnn_predictions": {"stage1_binary": {"is_abnormal": true, "status_thai": "ผิดปกติ (Cardiac Pathology Detected)", "prob_abnormal": 98.9, "prob_normal": 1.1}, "stage2_multiclass": {"predicted_class": "STTC", "probabilities": {"CD": 0.1057, "HYP": 0.0057, "MI": 0.2251, "NORM": 0.0154, "STTC": 0.6482}}}, "cnn_1d_cam_weights": [0.1534000039100647, 0.1534000039100647, 0.1534000039100647, 0.1534000039100647, 0.17820000648498535, 0.20759999752044678, 0.23690000176429749, 0.2662999927997589, 0.2955999970436096, 0.32499998807907104, 0.34209999442100525, 0.3433000147342682, 0.34439998865127563, 0.3456000089645386, 0.3467999994754791, 0.3479999899864197, 0.3499999940395355, 0.3828999996185303, 0.415800005197525, 0.4487000107765198, 0.48159998655319214, 0.5144000053405762, 0.5472999811172485, 0.6021999716758728, 0.6708999872207642, 0.7394999861717224, 0.8082000017166138, 0.876800000667572, 0.9455000162124634, 0.9937999844551086, 0.9629999995231628, 0.932200014591217, 0.9014000296592712, 0.8705000281333923, 0.8396999835968018, 0.808899998664856, 0.8240000009536743, 0.8508999943733215, 0.8779000043869019, 0.9049000144004822, 0.9319000244140625, 0.9588000178337097, 0.9215999841690063, 0.7810999751091003, 0.6406999826431274, 0.5001999735832214, 0.3596999943256378, 0.219200000166893, 0.07880000025033951, 0.08089999854564667, 0.08709999918937683, 0.09319999814033508, 0.09929999709129333, 0.1054999977350235, 0.11159999668598175, 0.14110000431537628, 0.18860000371932983, 0.2362000048160553, 0.28380000591278076, 0.3312999904155731, 0.3788999915122986,