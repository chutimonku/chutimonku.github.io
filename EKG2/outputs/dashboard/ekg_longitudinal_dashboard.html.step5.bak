ับภาวะหลอดเลือดหัวใจโคโรนารีอุดตันเฉียบพลัน คลื่น QRS กว้าง 52 ms", "autonomic_evaluation": "ความแปรปรวนของหัวใจลดต่ำลงผิดปกติ (SDNN = 25.7 ms, RMSSD = 41.1 ms) สอดคล้องกับภาวะกระตุ้นของระบบประสาทซิมพาเทติกอย่างรุนแรงจากความเครียดของกล้ามเนื้อหัวใจเฉียบพลัน", "clinical_risk_level": "วิกฤตฉุกเฉิน (High Critical Risk - Immediate Intervention) 🔴", "risk_badge_color": "danger", "recommendations": ["ส่งตัวเข้าห้องสวนหัวใจและหลอดเลือด (Cardiac Catheterization Lab) ด่วนที่สุดเพื่อพิจารณาทำ Primary PCI ภายใน 90 นาที", "เจาะเลือดตรวจชีวมาร์กเกอร์กล้ามเนื้อหัวใจ High-Sensitivity Troponin-T (hs-cTnT) และ CK-MB ทันที", "ให้การรักษาเบื้องต้นตามแนวทาง ACS: แอสไพรินเคี้ยวกลืน, ยาต้านเกล็ดเลือดตัวที่สอง (P2Y12 Inhibitor) และสารกันการแข็งตัวของเลือดภายใต้การควบคุมของอายุรแพทย์โรคหัวใจ"], "cot_reasoning": ["1. การวิเคราะห์จังหวะและอัตรา: อัตราเต้นเฉลี่ย 99 bpm อยู่ในเกณฑ์ ปกติ (60-100 bpm)", "2. การตรวจวัดช่วงเวลา: PR Interval ปกติ, QRS Duration = 52 ms (อยู่ในเกณฑ์ปกติ), QTc = 406 ms", "3. การตรวจสัณฐานการขาดเลือด: ST Elevation = +0.068 mV (ไม่พบ ST elevation วิกฤต)", "4. การวิเคราะห์แรงดันโครงสร้าง: Sokolow-Lyon = 1.03 mV (ปกติ)", "5. การบูรณาการโมเดล: โมเดล LightGBM และ ResNet1D ให้ผลพยากรณ์ชั้นโรคสูงสุดที่ 'MI' ด้วยความน่าจะเป็น 35.6% สอดคล้องกับพยาธิสภาพทางคลินิก"]}, "cnn_predictions": {"stage1_binary": {"is_abnormal": true, "status_thai": "ผิดปกติ (Cardiac Pathology Detected)", "prob_abnormal": 88.6, "prob_normal": 11.4}, "stage2_multiclass": {"predicted_class": "CD", "probabilities": {"CD": 0.4456, "HYP": 0.0336, "MI": 0.1741, "NORM": 0.1719, "STTC": 0.1748}}}, "cnn_1d_cam_weights": [0.05689999833703041, 0.05689999833703041, 0.05689999833703041, 0.05689999833703041, 0.09009999781847, 0.12939999997615814, 0.16869999468326569, 0.20810000598430634, 0.24740000069141388, 0.2867000102996826, 0.3255000114440918, 0.3634999990463257, 0.40149998664855957, 0.43950000405311584, 0.47749999165534973, 0.515500009059906, 0.5521000027656555, 0.5318999886512756, 0.5116999745368958, 0.4914999902