ลื่นไฟฟ้าหัวใจแบบต่อเนื่อง 24-48 ชั่วโมง (Holter Monitoring) หากผู้ป่วยมีอาการหน้ามืด วิงเวียน หรือเป็นลมหมดสติ (Syncope)", "ปรึกษาอายุรแพทย์โรคหัวใจเฉพาะทางด้านสรีรวิทยาไฟฟ้าหัวใจ (Electrophysiologist) เพื่อประเมินข้อบ่งชี้ในการใส่เครื่องกระตุ้นหัวใจ (Pacemaker / CRT)"], "cot_reasoning": ["1. การวิเคราะห์จังหวะและอัตรา: อัตราเต้นเฉลี่ย 85 bpm อยู่ในเกณฑ์ ปกติ (60-100 bpm)", "2. การตรวจวัดช่วงเวลา: PR Interval ปกติ, QRS Duration = 52 ms (อยู่ในเกณฑ์ปกติ), QTc = 309 ms", "3. การตรวจสัณฐานการขาดเลือด: ST Elevation = +0.084 mV (ไม่พบ ST elevation วิกฤต)", "4. การวิเคราะห์แรงดันโครงสร้าง: Sokolow-Lyon = 1.30 mV (ปกติ)", "5. การบูรณาการโมเดล: โมเดล LightGBM และ ResNet1D ให้ผลพยากรณ์ชั้นโรคสูงสุดที่ 'CD' ด้วยความน่าจะเป็น 63.4% สอดคล้องกับพยาธิสภาพทางคลินิก"]}, "cnn_predictions": {"stage1_binary": {"is_abnormal": true, "status_thai": "ผิดปกติ (Cardiac Pathology Detected)", "prob_abnormal": 100.0, "prob_normal": 0.0}, "stage2_multiclass": {"predicted_class": "MI", "probabilities": {"CD": 0.0625, "HYP": 0.0, "MI": 0.9179, "NORM": 0.0003, "STTC": 0.0193}}}, "cnn_1d_cam_weights": [0.31139999628067017, 0.31139999628067017, 0.31139999628067017, 0.31139999628067017, 0.3100999891757965, 0.3086000084877014, 0.30709999799728394, 0.30559998750686646, 0.30410000681877136, 0.3025999963283539, 0.3133000135421753, 0.3400999903678894, 0.3668000102043152, 0.3935000002384186, 0.420199990272522, 0.44690001010894775, 0.4731000065803528, 0.4781000018119812, 0.4830000102519989, 0.4880000054836273, 0.492900013923645, 0.49779999256134033, 0.5027999877929688, 0.5063999891281128, 0.5091000199317932, 0.5117999911308289, 0.5144000053405762, 0.5170999765396118, 0.5198000073432922, 0.5340999960899353, 0.593500018119812, 0.6528000235557556, 0.7121999859809875, 0.7716000080108643, 0.8309999704360962, 0.8902999758720398, 0.9146999716758728, 0.9298999905586243, 0.9452000260353088, 0.9603999853134155, 0.975600004196167, 0.9908999800682068, 0.9829999804496765, 0.9379000067710876, 0.8928999900817871, 0.84789