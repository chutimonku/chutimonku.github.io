แพทย์โรคหัวใจ"], "cot_reasoning": ["1. การวิเคราะห์จังหวะและอัตรา: อัตราเต้นเฉลี่ย 82 bpm อยู่ในเกณฑ์ ปกติ (60-100 bpm)", "2. การตรวจวัดช่วงเวลา: PR Interval ปกติ, QRS Duration = 86 ms (อยู่ในเกณฑ์ปกติ), QTc = 225 ms", "3. การตรวจสัณฐานการขาดเลือด: ST Elevation = +0.184 mV (ยกตัวเด่นชัดเสี่ยงต่อ STEMI)", "4. การวิเคราะห์แรงดันโครงสร้าง: Sokolow-Lyon = 3.96 mV (เข้าเกณฑ์หัวใจโต LVH >3.5 mV)", "5. การบูรณาการโมเดล: โมเดล LightGBM และ ResNet1D ให้ผลพยากรณ์ชั้นโรคสูงสุดที่ 'MI' ด้วยความน่าจะเป็น 51.9% สอดคล้องกับพยาธิสภาพทางคลินิก"]}, "cnn_predictions": {"stage1_binary": {"is_abnormal": true, "status_thai": "ผิดปกติ (Cardiac Pathology Detected)", "prob_abnormal": 98.4, "prob_normal": 1.6}, "stage2_multiclass": {"predicted_class": "MI", "probabilities": {"CD": 0.1481, "HYP": 0.0039, "MI": 0.7592, "NORM": 0.0206, "STTC": 0.0682}}}, "cnn_1d_cam_weights": [0.24799999594688416, 0.24799999594688416, 0.24799999594688416, 0.24799999594688416, 0.2599000036716461, 0.27399998903274536, 0.288100004196167, 0.3021000027656555, 0.31619998812675476, 0.3303000032901764, 0.3644999861717224, 0.42489999532699585, 0.48539999127388, 0.5458999872207642, 0.6062999963760376, 0.6668000221252441, 0.7239999771118164, 0.6539999842643738, 0.5839999914169312, 0.5138999819755554, 0.4438999891281128, 0.37389999628067017, 0.30379998683929443, 0.28540000319480896, 0.2994000017642975, 0.3133000135421753, 0.3273000121116638, 0.34130001068115234, 0.35530000925064087, 0.3716999888420105, 0.3977000117301941, 0.4237000048160553, 0.4496000111103058, 0.475600004196167, 0.5016000270843506, 0.5275999903678894, 0.4921000003814697, 0.4406999945640564, 0.38920000195503235, 0.337799996137619, 0.28630000352859497, 0.23489999771118164, 0.20479999482631683, 0.20919999480247498, 0.21359999477863312, 0.21799999475479126, 0.2223999947309494, 0.22679999470710754, 0.23119999468326569, 0.20479999482631683, 0.17759999632835388, 0.15039999783039093, 0.12319999933242798, 0.09600000083446503, 0.06880000233650208, 0.058899998664855