นหัวใจ (SDNN = 7.5 ms, RMSSD = 10.7 ms) สะท้อนการทำงานของระบบประสาทเวกัสและระบบประสาทอัตโนมัติที่อยู่ในเกณฑ์สมดุลดี", "clinical_risk_level": "ความเสี่ยงต่ำ (Low Risk - Disease Free) 🟢", "risk_badge_color": "success", "recommendations": ["แนะนำตรวจติดตามสุขภาพหัวใจประจำปีตามวงรอบปกติ", "รักษาระดับการออกกำลังกายแบบแอโรบิกสม่ำเสมออย่างน้อย 150 นาที/สัปดาห์", "ควบคุมพฤติกรรมสุขภาพ หลีกเลี่ยงอาหารไขมันทรานส์ และตรวจคัดกรองความดันโลหิตเป็นระยะ"], "cot_reasoning": ["1. การวิเคราะห์จังหวะและอัตรา: อัตราเต้นเฉลี่ย 91 bpm อยู่ในเกณฑ์ ปกติ (60-100 bpm)", "2. การตรวจวัดช่วงเวลา: PR Interval ปกติ, QRS Duration = 65 ms (อยู่ในเกณฑ์ปกติ), QTc = 343 ms", "3. การตรวจสัณฐานการขาดเลือด: ST Elevation = +0.087 mV (ไม่พบ ST elevation วิกฤต)", "4. การวิเคราะห์แรงดันโครงสร้าง: Sokolow-Lyon = 2.03 mV (ปกติ)", "5. การบูรณาการโมเดล: โมเดล LightGBM และ ResNet1D ให้ผลพยากรณ์ชั้นโรคสูงสุดที่ 'NORM' ด้วยความน่าจะเป็น 91.8% สอดคล้องกับพยาธิสภาพทางคลินิก"]}, "cnn_predictions": {"stage1_binary": {"is_abnormal": false, "status_thai": "ปกติ (Normal Sinus)", "prob_abnormal": 7.1, "prob_normal": 92.9}, "stage2_multiclass": {"predicted_class": "NORM", "probabilities": {"CD": 0.0083, "HYP": 0.0205, "MI": 0.0162, "NORM": 0.942, "STTC": 0.013}}}, "cnn_1d_cam_weights": [0.010599999688565731, 0.010599999688565731, 0.010599999688565731, 0.010599999688565731, 0.01889999955892563, 0.02879999950528145, 0.03869999945163727, 0.04859999939799309, 0.058400001376867294, 0.06830000132322311, 0.08139999955892563, 0.09870000183582306, 0.11599999666213989, 0.13330000638961792, 0.15060000121593475, 0.1678999960422516, 0.18410000205039978, 0.1551000028848648, 0.12620000541210175, 0.09719999879598618, 0.0681999996304512, 0.03920000046491623, 0.010200000368058681, 0.03970000147819519, 0.10580000281333923, 0.17190000414848328, 0.23800000548362732, 0.30410000681877136, 0.3702000081539154, 0.42489999532699585, 0.43470001220703125, 0.444599986076355, 0.4544000029563904, 0.4643000066280365, 0.4742000102996826, 0.48399999737739563,