งสร้าง: Sokolow-Lyon = 0.95 mV (ปกติ)", "5. การบูรณาการโมเดล: โมเดล LightGBM และ ResNet1D ให้ผลพยากรณ์ชั้นโรคสูงสุดที่ 'CD' ด้วยความน่าจะเป็น 58.4% สอดคล้องกับพยาธิสภาพทางคลินิก"]}, "cnn_predictions": {"stage1_binary": {"is_abnormal": true, "status_thai": "ผิดปกติ (Cardiac Pathology Detected)", "prob_abnormal": 98.4, "prob_normal": 1.6}, "stage2_multiclass": {"predicted_class": "MI", "probabilities": {"CD": 0.3927, "HYP": 0.0028, "MI": 0.554, "NORM": 0.0153, "STTC": 0.0352}}}, "cnn_1d_cam_weights": [0.0, 0.0, 0.0, 0.0, 0.03139999881386757, 0.06849999725818634, 0.10570000112056732, 0.1428000032901764, 0.17990000545978546, 0.21709999442100525, 0.257099986076355, 0.30079999566078186, 0.34450000524520874, 0.38830000162124634, 0.4320000112056732, 0.4756999909877777, 0.5188999772071838, 0.5419999957084656, 0.5651000142097473, 0.5881999731063843, 0.611299991607666, 0.6342999935150146, 0.6574000120162964, 0.6585000157356262, 0.6459000110626221, 0.6331999897956848, 0.6205000281333923, 0.6078000068664551, 0.5952000021934509, 0.578000009059906, 0.5432999730110168, 0.5085999965667725, 0.4740000069141388, 0.439300000667572, 0.40459999442100525, 0.3698999881744385, 0.3871999979019165, 0.4180999994277954, 0.4490000009536743, 0.4797999858856201, 0.510699987411499, 0.5415999889373779, 0.5673999786376953, 0.5852000117301941, 0.6029000282287598, 0.6207000017166138, 0.6384999752044678, 0.6561999917030334, 0.6740000247955322, 0.6922000050544739, 0.7103999853134155, 0.7285000085830688, 0.7466999888420105, 0.7649000287055969, 0.7831000089645386, 0.809499979019165, 0.8424000144004822, 0.8751999735832214, 0.9079999923706055, 0.9409000277519226, 0.9736999869346619, 0.9959999918937683, 0.9593999981880188, 0.9228000044822693, 0.8862000107765198, 0.8495000004768372, 0.8129000067710876, 0.7763000130653381, 0.7799999713897705, 0.7976999878883362, 0.8152999877929688, 0.8330000042915344, 0.8507000207901001, 0.8683000206947327, 0.8751000165939331, 0.8597999811172485, 0.8445000052452087, 0.8292000293