-Lyon = 1.23 mV (ปกติ)", "5. การบูรณาการโมเดล: โมเดล LightGBM และ ResNet1D ให้ผลพยากรณ์ชั้นโรคสูงสุดที่ 'CD' ด้วยความน่าจะเป็น 66.0% สอดคล้องกับพยาธิสภาพทางคลินิก"]}, "cnn_predictions": {"stage1_binary": {"is_abnormal": true, "status_thai": "ผิดปกติ (Cardiac Pathology Detected)", "prob_abnormal": 97.6, "prob_normal": 2.4}, "stage2_multiclass": {"predicted_class": "CD", "probabilities": {"CD": 0.4747, "HYP": 0.0093, "MI": 0.2841, "NORM": 0.0366, "STTC": 0.1953}}}, "cnn_1d_cam_weights": [0.005400000140070915, 0.005400000140070915, 0.005400000140070915, 0.005400000140070915, 0.004699999932199717, 0.003800000064074993, 0.003000000026077032, 0.002099999925121665, 0.0013000000035390258, 0.0005000000237487257, 0.02419999986886978, 0.08009999990463257, 0.13590000569820404, 0.19169999659061432, 0.2476000040769577, 0.3034000098705292, 0.3573000133037567, 0.3353999853134155, 0.313400000333786, 0.2915000021457672, 0.2694999873638153, 0.2476000040769577, 0.225600004196167, 0.23280000686645508, 0.2583000063896179, 0.28380000591278076, 0.3093000054359436, 0.33469998836517334, 0.3601999878883362, 0.3684000074863434, 0.3089999854564667, 0.24969999492168427, 0.19030000269412994, 0.13099999725818634, 0.07159999758005142, 0.012199999764561653, 0.04500000178813934, 0.10159999877214432, 0.1582999974489212, 0.2150000035762787, 0.271699994802475, 0.32829999923706055, 0.3898000121116638, 0.45890000462532043, 0.5281000137329102, 0.5971999764442444, 0.6664000153541565, 0.7354999780654907, 0.8046000003814697, 0.7134000062942505, 0.6176999807357788, 0.5220000147819519, 0.4262999892234802, 0.33059999346733093, 0.23489999771118164, 0.21979999542236328, 0.267300009727478, 0.3147999942302704, 0.36230000853538513, 0.4097000062465668, 0.45719999074935913, 0.48660001158714294, 0.41519999504089355, 0.34380000829696655, 0.27239999175071716, 0.20100000500679016, 0.12950000166893005, 0.05810000002384186, 0.07429999858140945, 0.12099999934434891, 0.16760000586509705, 0.2142000049352646, 0.26080000400543213