                <!-- 12-Lead Waveform with XAI Overlay (100% FULL WIDTH col-12) -->
                <div class="card card-custom mb-4" id="sec-12lead-xai">
                    <div class="card-header-custom">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-brain me-2 text-danger"></i>
                            <span>คลื่นไฟฟ้าหัวใจ 12 ลีด พร้อมไฮไลต์อธิบายผล (12-Lead EKG + XAI Waveform Attribution — 100% Full-Width)</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <label class="small text-muted mb-0 font-code">สลับลีด:</label>
                            <select class="form-select form-select-sm" id="select-encounter-lead" style="width: 140px;" onchange="updateEncounterWaveformView()">
                                <option value="II" selected>Lead II</option>
                                <option value="I">Lead I</option>
                                <option value="III">Lead III</option>
                                <option value="aVR">Lead aVR</option>
                                <option value="aVL">Lead aVL</option>
                                <option value="aVF">Lead aVF</option>
