อหัวใจหนาตัว (Reverse Remodeling)", "ประเมินหาภาวะแทรกซ้อน เช่น ภาวะหัวใจล้มเหลว (Heart Failure with Preserved Ejection Fraction - HFpEF)"], "cot_reasoning": ["1. การวิเคราะห์จังหวะและอัตรา: อัตราเต้นเฉลี่ย 77 bpm อยู่ในเกณฑ์ ปกติ (60-100 bpm)", "2. การตรวจวัดช่วงเวลา: PR Interval ปกติ, QRS Duration = 95 ms (อยู่ในเกณฑ์ปกติ), QTc = 212 ms", "3. การตรวจสัณฐานการขาดเลือด: ST Elevation = +0.149 mV (ยกตัวเด่นชัดเสี่ยงต่อ STEMI)", "4. การวิเคราะห์แรงดันโครงสร้าง: Sokolow-Lyon = 4.15 mV (เข้าเกณฑ์หัวใจโต LVH >3.5 mV)", "5. การบูรณาการโมเดล: โมเดล LightGBM และ ResNet1D ให้ผลพยากรณ์ชั้นโรคสูงสุดที่ 'HYP' ด้วยความน่าจะเป็น 83.2% สอดคล้องกับพยาธิสภาพทางคลินิก"]}, "cnn_predictions": {"stage1_binary": {"is_abnormal": true, "status_thai": "ผิดปกติ (Cardiac Pathology Detected)", "prob_abnormal": 99.5, "prob_normal": 0.5}, "stage2_multiclass": {"predicted_class": "MI", "probabilities": {"CD": 0.1817, "HYP": 0.0024, "MI": 0.6622, "NORM": 0.0078, "STTC": 0.146}}}, "cnn_1d_cam_weights": [0.6553999781608582, 0.6553999781608582, 0.6553999781608582, 0.6553999781608582, 0.673799991607666, 0.6955000162124634, 0.7172999978065491, 0.7390000224113464, 0.7608000040054321, 0.7825000286102295, 0.8073999881744385, 0.8364999890327454, 0.8655999898910522, 0.8946999907493591, 0.923799991607666, 0.9528999924659729, 0.9790999889373779, 0.8931999802589417, 0.8073999881744385, 0.7214999794960022, 0.6355999708175659, 0.5497000217437744, 0.46380001306533813, 0.41920000314712524, 0.4004000127315521, 0.3815999925136566, 0.3628000020980835, 0.3440999984741211, 0.325300008058548, 0.31209999322891235, 0.3206000030040741, 0.32899999618530273, 0.3375000059604645, 0.34599998593330383, 0.35440000891685486, 0.3628999888896942, 0.3497999906539917, 0.3310999870300293, 0.3125, 0.2937999963760376, 0.2750999927520752, 0.2563999891281128, 0.2425999939441681, 0.23659999668598175, 0.2305999994277954, 0.22460000216960907, 0.21860000491142273, 0.2125999927520752, 0.20659999549388885, 0.25450000166893005, 0.30379998683929443