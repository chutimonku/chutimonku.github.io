 สอดคล้องกับภาวะกระตุ้นของระบบประสาทซิมพาเทติกอย่างรุนแรงจากความเครียดของกล้ามเนื้อหัวใจเฉียบพลัน", "clinical_risk_level": "วิกฤตฉุกเฉิน (High Critical Risk - Immediate Intervention) 🔴", "risk_badge_color": "danger", "recommendations": ["ส่งตัวเข้าห้องสวนหัวใจและหลอดเลือด (Cardiac Catheterization Lab) ด่วนที่สุดเพื่อพิจารณาทำ Primary PCI ภายใน 90 นาที", "เจาะเลือดตรวจชีวมาร์กเกอร์กล้ามเนื้อหัวใจ High-Sensitivity Troponin-T (hs-cTnT) และ CK-MB ทันที", "ให้การรักษาเบื้องต้นตามแนวทาง ACS: แอสไพรินเคี้ยวกลืน, ยาต้านเกล็ดเลือดตัวที่สอง (P2Y12 Inhibitor) และสารกันการแข็งตัวของเลือดภายใต้การควบคุมของอายุรแพทย์โรคหัวใจ"], "cot_reasoning": ["1. การวิเคราะห์จังหวะและอัตรา: อัตราเต้นเฉลี่ย 99 bpm อยู่ในเกณฑ์ ปกติ (60-100 bpm)", "2. การตรวจวัดช่วงเวลา: PR Interval ปกติ, QRS Duration = 94 ms (อยู่ในเกณฑ์ปกติ), QTc = 479 ms", "3. การตรวจสัณฐานการขาดเลือด: ST Elevation = +0.112 mV (ยกตัวเด่นชัดเสี่ยงต่อ STEMI)", "4. การวิเคราะห์แรงดันโครงสร้าง: Sokolow-Lyon = 2.36 mV (ปกติ)", "5. การบูรณาการโมเดล: โมเดล LightGBM และ ResNet1D ให้ผลพยากรณ์ชั้นโรคสูงสุดที่ 'MI' ด้วยความน่าจะเป็น 87.6% สอดคล้องกับพยาธิสภาพทางคลินิก"]}, "cnn_predictions": {"stage1_binary": {"is_abnormal": true, "status_thai": "ผิดปกติ (Cardiac Pathology Detected)", "prob_abnormal": 100.0, "prob_normal": 0.0}, "stage2_multiclass": {"predicted_class": "MI", "probabilities": {"CD": 0.0007, "HYP": 0.0, "MI": 0.9978, "NORM": 0.0001, "STTC": 0.0015}}}, "cnn_1d_cam_weights": [0.40720000863075256, 0.40720000863075256, 0.40720000863075256, 0.40720000863075256, 0.44609999656677246, 0.49219998717308044, 0.5382000207901001, 0.5842000246047974, 0.630299985408783, 0.6762999892234802, 0.6904000043869019, 0.663100004196167, 0.635699987411499, 0.608299970626831, 0.5809999704360962, 0.553600013256073, 0.5277000069618225, 0.5625, 0.5974000096321106, 0.6322000026702881, 0.6669999957084656, 0.7017999887466431, 0.7365999817848206, 0.7398999929428101, 0.7233999967575073, 0.7069000005722046, 0.690500020980835, 0.6740000247955322, 0.6575000286