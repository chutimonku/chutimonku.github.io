ms", "3. การตรวจสัณฐานการขาดเลือด: ST Elevation = +0.142 mV (ยกตัวเด่นชัดเสี่ยงต่อ STEMI)", "4. การวิเคราะห์แรงดันโครงสร้าง: Sokolow-Lyon = 1.29 mV (ปกติ)", "5. การบูรณาการโมเดล: โมเดล LightGBM และ ResNet1D ให้ผลพยากรณ์ชั้นโรคสูงสุดที่ 'STTC' ด้วยความน่าจะเป็น 82.2% สอดคล้องกับพยาธิสภาพทางคลินิก"]}, "cnn_predictions": {"stage1_binary": {"is_abnormal": true, "status_thai": "ผิดปกติ (Cardiac Pathology Detected)", "prob_abnormal": 98.8, "prob_normal": 1.2}, "stage2_multiclass": {"predicted_class": "MI", "probabilities": {"CD": 0.0117, "HYP": 0.0008, "MI": 0.937, "NORM": 0.0173, "STTC": 0.0333}}}, "cnn_1d_cam_weights": [0.3671000003814697, 0.3671000003814697, 0.3671000003814697, 0.3671000003814697, 0.3808000087738037, 0.3970000147819519, 0.4133000075817108, 0.429500013589859, 0.4456999897956848, 0.461899995803833, 0.4708000123500824, 0.47029998898506165, 0.4697999954223633, 0.4693000018596649, 0.46869999170303345, 0.4681999981403351, 0.4690000116825104, 0.5231000185012817, 0.5771999955177307, 0.6312999725341797, 0.6854000091552734, 0.7394000291824341, 0.7935000061988831, 0.7926999926567078, 0.7573999762535095, 0.7221999764442444, 0.6869000196456909, 0.6516000032424927, 0.6162999868392944, 0.5981000065803528, 0.6464999914169312, 0.6949999928474426, 0.7434999942779541, 0.7918999791145325, 0.840399980545044, 0.8888999819755554, 0.8654999732971191, 0.8234999775886536, 0.781499981880188, 0.7394000291824341, 0.6973999738693237, 0.6553999781608582, 0.6337000131607056, 0.6446999907493591, 0.6557000279426575, 0.666700005531311, 0.6777999997138977, 0.6887999773025513, 0.6998000144958496, 0.7390999794006348, 0.77920001745224, 0.8192999958992004, 0.8593999743461609, 0.8995000123977661, 0.9395999908447266, 0.9495999813079834, 0.9362000226974487, 0.9228000044822693, 0.909500002861023, 0.8960999846458435, 0.8827000260353088, 0.8744000196456909, 0.8945000171661377, 0.9146000146865845, 0.9347000122070312, 0.9546999931335449, 0.9747999906539917, 0.9948999881744385, 0.9987000226974487, 0.