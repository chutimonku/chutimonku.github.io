t_reasoning": ["1. การวิเคราะห์จังหวะและอัตรา: อัตราเต้นเฉลี่ย 110 bpm อยู่ในเกณฑ์ เต้นเร็วผิดปกติ (>100 bpm)", "2. การตรวจวัดช่วงเวลา: PR Interval ปกติ, QRS Duration = 38 ms (อยู่ในเกณฑ์ปกติ), QTc = 359 ms", "3. การตรวจสัณฐานการขาดเลือด: ST Elevation = +0.112 mV (ยกตัวเด่นชัดเสี่ยงต่อ STEMI)", "4. การวิเคราะห์แรงดันโครงสร้าง: Sokolow-Lyon = 1.10 mV (ปกติ)", "5. การบูรณาการโมเดล: โมเดล LightGBM และ ResNet1D ให้ผลพยากรณ์ชั้นโรคสูงสุดที่ 'CD' ด้วยความน่าจะเป็น 50.4% สอดคล้องกับพยาธิสภาพทางคลินิก"]}, "cnn_predictions": {"stage1_binary": {"is_abnormal": true, "status_thai": "ผิดปกติ (Cardiac Pathology Detected)", "prob_abnormal": 99.8, "prob_normal": 0.2}, "stage2_multiclass": {"predicted_class": "CD", "probabilities": {"CD": 0.591, "HYP": 0.0005, "MI": 0.3759, "NORM": 0.0033, "STTC": 0.0293}}}, "cnn_1d_cam_weights": [0.5314000248908997, 0.5314000248908997, 0.5314000248908997, 0.5314000248908997, 0.5088000297546387, 0.4821999967098236, 0.4555000066757202, 0.42890000343322754, 0.40220001339912415, 0.37560001015663147, 0.37439998984336853, 0.40639999508857727, 0.438400000333786, 0.47040000557899475, 0.5023999810218811, 0.5343999862670898, 0.5659000277519226, 0.5795999765396118, 0.5932999849319458, 0.6069999933242798, 0.6207000017166138, 0.6344000101089478, 0.6481000185012817, 0.6292999982833862, 0.5899999737739563, 0.5507000088691711, 0.5115000009536743, 0.4722000062465668, 0.43290001153945923, 0.4009000062942505, 0.3970000147819519, 0.39309999346733093, 0.38929998874664307, 0.3853999972343445, 0.3815000057220459, 0.37770000100135803, 0.35370001196861267, 0.32440000772476196, 0.29510000348091125, 0.26589998602867126, 0.23659999668598175, 0.20739999413490295, 0.17839999496936798, 0.14990000426769257, 0.12139999866485596, 0.09290000051259995, 0.06440000236034393, 0.03590000048279762, 0.007400000002235174, 0.061799999326467514, 0.1185000017285347, 0.17520000040531158, 0.23199999332427979, 0.28870001435279846, 0.34540000557899475, 0.3783000111579895, 0.3926999866962433, 0.407