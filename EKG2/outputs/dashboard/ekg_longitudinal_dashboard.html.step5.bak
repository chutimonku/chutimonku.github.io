่วงเวลา: PR Interval ปกติ, QRS Duration = 20 ms (อยู่ในเกณฑ์ปกติ), QTc = 314 ms", "3. การตรวจสัณฐานการขาดเลือด: ST Elevation = +0.049 mV (ไม่พบ ST elevation วิกฤต)", "4. การวิเคราะห์แรงดันโครงสร้าง: Sokolow-Lyon = 1.49 mV (ปกติ)", "5. การบูรณาการโมเดล: โมเดล LightGBM และ ResNet1D ให้ผลพยากรณ์ชั้นโรคสูงสุดที่ 'MI' ด้วยความน่าจะเป็น 74.6% สอดคล้องกับพยาธิสภาพทางคลินิก"]}, "cnn_predictions": {"stage1_binary": {"is_abnormal": true, "status_thai": "ผิดปกติ (Cardiac Pathology Detected)", "prob_abnormal": 99.4, "prob_normal": 0.6}, "stage2_multiclass": {"predicted_class": "MI", "probabilities": {"CD": 0.016, "HYP": 0.0001, "MI": 0.9762, "NORM": 0.0057, "STTC": 0.0019}}}, "cnn_1d_cam_weights": [0.01600000075995922, 0.01600000075995922, 0.01600000075995922, 0.01600000075995922, 0.013899999670684338, 0.01140000019222498, 0.008799999952316284, 0.006300000008195639, 0.003800000064074993, 0.0013000000035390258, 0.026799999177455902, 0.08889999985694885, 0.1509999930858612, 0.21299999952316284, 0.2750999927520752, 0.33719998598098755, 0.39890000224113464, 0.4440000057220459, 0.48919999599456787, 0.5343999862670898, 0.5795000195503235, 0.6247000098228455, 0.6699000000953674, 0.6783999800682068, 0.6639999747276306, 0.6495000123977661, 0.6351000070571899, 0.6207000017166138, 0.6061999797821045, 0.5928000211715698, 0.5834000110626221, 0.5741000175476074, 0.5647000074386597, 0.555400013923645, 0.5460000038146973, 0.5367000102996826, 0.5667999982833862, 0.6071000099182129, 0.6474999785423279, 0.6877999901771545, 0.7282000184059143, 0.7684999704360962, 0.8058000206947327, 0.8381999731063843, 0.8705000281333923, 0.902899980545044, 0.9352999925613403, 0.9675999879837036, 1.0, 0.9261000156402588, 0.8493000268936157, 0.7724999785423279, 0.6956999897956848, 0.6189000010490417, 0.5421000123023987, 0.515999972820282, 0.5293999910354614, 0.5426999926567078, 0.5561000108718872, 0.5694000124931335, 0.5827999711036682, 0.5967000126838684, 0.6133000254631042, 0.6299999952316284, 0.6467000246047974,